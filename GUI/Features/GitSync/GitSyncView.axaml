<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.GitSync"
             x:Class="Hammer5Tools.App.Features.GitSync.GitSyncView"
             x:DataType="vm:GitSyncViewModel">
  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="8">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <TextBlock Text="{Binding BranchName, StringFormat='Branch: {0}'}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshStatusCommand}" />
    </Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding ChangedFiles}" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6">
      <Button Content="Pull (Rebase)" Command="{Binding PullCommand}" />
      <Button Content="Push" Command="{Binding PushCommand}" />
    </StackPanel>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TextBox Text="{Binding CommitMessage}" PlaceholderText="Commit message..." AcceptsReturn="True" MinHeight="70" />
      <Button Grid.Column="1" Content="Commit All" Command="{Binding CommitCommand}" Margin="6,0,0,0" />
    </Grid>
    <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" />
  </Grid>
</UserControl>
