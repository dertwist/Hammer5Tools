<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.SoundEvents"
             xmlns:workspace="using:Hammer5Tools.App.Controls"
             xmlns:m="using:Hammer5Tools.Core.SoundEvents"
             x:Class="Hammer5Tools.App.Features.SoundEvents.SoundEventEditorView"
             x:Name="RootControl"
             x:DataType="vm:SoundEventEditorViewModel">
  <workspace:WorkspaceView LayoutKey="SoundEvents" LeftTitle="Soundevents" RightTitle="Audio Explorer">
    <workspace:WorkspaceView.LeftContent>
<Border  Background="{DynamicResource H5TBackgroundBrush}" CornerRadius="2" Padding="8" Margin="0,0,8,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Sound Events" FontWeight="Bold" Margin="4,0,0,8" />
        <TextBox Grid.Row="1" Text="{Binding SearchFilter}" PlaceholderText="Filter events..." Margin="0,0,0,8" />

        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredEvents}" SelectedItem="{Binding SelectedEvent}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:SoundEvent">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{DynamicResource H5TAccentBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="0,8,0,0">
          <Button Grid.Column="0" Content="Add Event" Command="{Binding AddEventCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
          <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteEventCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
        </Grid>
      </Grid>
    </Border>
    </workspace:WorkspaceView.LeftContent>
    <workspace:WorkspaceView.CenterContent>
<Border  Background="{DynamicResource H5TBackgroundBrush}" CornerRadius="2" Padding="8" Margin="0,0,8,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Event Properties" FontSize="14.667" FontWeight="Bold" Margin="0,0,0,8" />

        <!-- Header properties -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
          <Grid ColumnDefinitions="120,*">
            <TextBlock Grid.Column="0" Text="Event Name:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SelectedEvent.Name, FallbackValue=''}" />
          </Grid>
          <Grid ColumnDefinitions="120,*">
            <TextBlock Grid.Column="0" Text="Type:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SelectedEvent.Type, FallbackValue=''}" />
          </Grid>
        </StackPanel>

        <!-- Dynamic properties list -->
        <ListBox Grid.Row="2" ItemsSource="{Binding SelectedEvent.Properties}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:SoundProperty">
              <Grid ColumnDefinitions="160,*,Auto" Margin="0,2">
                <TextBox Grid.Column="0" Text="{Binding Key}" Margin="0,0,4,0" />
                <TextBox Grid.Column="1" Text="{Binding Value}" Margin="4,0" />
                <Button Grid.Column="2" Content="✕"
                        Command="{Binding #RootControl.((vm:SoundEventEditorViewModel)DataContext).DeletePropertyCommand}"
                        CommandParameter="{Binding}"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="4,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Content="Add Property" Command="{Binding AddPropertyCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" />
          <Button Content="Load" Command="{Binding ReloadCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    </workspace:WorkspaceView.CenterContent>
    <workspace:WorkspaceView.RightContent>
      <TabControl>
        <TabItem Header="Addon">
          <ListBox ItemsSource="{Binding AddonSounds}" />
        </TabItem>
        <TabItem Header="Internal">
          <Grid RowDefinitions="Auto,*">
            <Button Content="Search Game VPK" Command="{Binding SearchVpkCommand}" HorizontalAlignment="Stretch" Margin="4" />
            <ListBox Grid.Row="1" ItemsSource="{Binding VpkSounds}" />
          </Grid>
        </TabItem>
      </TabControl>
    </workspace:WorkspaceView.RightContent>
  </workspace:WorkspaceView>
</UserControl>
