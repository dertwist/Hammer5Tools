<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hotkeys="using:Hammer5Tools.App.Features.Hotkeys"
             xmlns:detailprops="using:Hammer5Tools.App.Features.DetailProps"
             xmlns:console="using:Hammer5Tools.App.Features.Console"
             xmlns:loading="using:Hammer5Tools.App.Features.LoadingScreens"
             xmlns:sound="using:Hammer5Tools.App.Features.SoundEvents"
             xmlns:mapbuild="using:Hammer5Tools.App.Features.MapBuilder"
             xmlns:navmesh="using:Hammer5Tools.App.Features.NavMesh"
             xmlns:assettools="using:Hammer5Tools.App.Features.AssetTools"
             xmlns:gitsync="using:Hammer5Tools.App.Features.GitSync"
             xmlns:preferences="using:Hammer5Tools.App.Features.Preferences"
             xmlns:smartprops="using:Hammer5Tools.App.Features.SmartProps"
             xmlns:workshop="using:Hammer5Tools.App.Features.Workshop"
             xmlns:workshopgui="using:GUI"
             xmlns:dock="using:Dock.Model.Mvvm.Controls"
             xmlns:dockthemes="using:Dock.Avalonia.Themes.Fluent"
             xmlns:conv="using:Hammer5Tools.App.Converters"
             x:Class="Hammer5Tools.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <x:Boolean x:Key="DockDocumentControlTabStripVisible">False</x:Boolean>
    <conv:UriToBitmapConverter x:Key="UriToBitmapConverter" />
  </Application.Resources>
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type smartprops:SmartPropEditorViewModel}" x:DataType="smartprops:SmartPropEditorViewModel"><ContentControl Content="{Binding View}" /></DataTemplate>
    <DataTemplate DataType="{x:Type workshop:WorkshopManagerViewModel}">
      <workshopgui:WorkshopManagerView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type preferences:PreferencesViewModel}"><preferences:PreferencesView /></DataTemplate>
    <DataTemplate DataType="{x:Type dock:Tool}" x:DataType="dock:Tool">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type dock:Document}" x:DataType="dock:Document">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type hotkeys:HotkeyEditorViewModel}">
      <hotkeys:HotkeyEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type detailprops:DetailPropEditorViewModel}">
      <detailprops:DetailPropEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type console:ConsoleViewModel}">
      <console:ConsoleView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type loading:LoadingEditorViewModel}">
      <loading:LoadingEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sound:SoundEventEditorViewModel}">
      <sound:SoundEventEditorView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type mapbuild:MapBuilderViewModel}">
      <mapbuild:MapBuilderView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type navmesh:NavMeshRadarViewModel}">
      <navmesh:NavMeshRadarView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type assettools:AssetToolsViewModel}">
      <assettools:AssetToolsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type gitsync:GitSyncViewModel}">
      <gitsync:GitSyncView />
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <dockthemes:DockFluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://Hammer5Tools/Styles/HammerTheme.axaml" />
  </Application.Styles>
</Application>
