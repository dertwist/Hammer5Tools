<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Hammer5Tools.App.Features.Shell"
        xmlns:vm="using:Hammer5Tools.App.ViewModels"
        xmlns:addons="using:Hammer5Tools.Core.Addons"
        xmlns:explorer="using:Hammer5Tools.App.Features.Explorer"
        xmlns:workspace="using:Hammer5Tools.App.Controls"
        xmlns:conv="using:Hammer5Tools.App.Converters"
        x:Class="Hammer5Tools.App.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="Hammer 5 Tools"
        Icon="avares://Hammer5Tools/Assets/Icons/appicon.ico"
        Width="1440"
        Height="900"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ControlTheme x:Key="EditorMenuItemTheme" TargetType="MenuItem"
                  BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="shell:EditorMenuAction">
      <Setter Property="Header" Value="{Binding Header}" />
      <Setter Property="Command" Value="{Binding Command}" />
      <Setter Property="ItemsSource" Value="{Binding Children}" />
      <Setter Property="ItemContainerTheme" Value="{DynamicResource EditorMenuItemTheme}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="Tag" Value="{Binding Kind}" />
      <Setter Property="Icon">
        <Template>
          <Image Source="{Binding IconUri, Converter={StaticResource UriToBitmapConverter}}" Width="16" Height="16" />
        </Template>
      </Setter>
      <Style Selector="^[Tag=separator]">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Height" Value="1" />
        <Setter Property="MinHeight" Value="1" />
        <Setter Property="Template">
          <ControlTemplate><Separator /></ControlTemplate>
        </Setter>
      </Style>
    </ControlTheme>
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
      <TabControl Grid.Row="1" Name="EditorTabs"
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding ActiveDocument}"
                  Background="{DynamicResource H5TSurfaceRaisedBrush}">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentViewModel">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Image Source="{Binding IconUri, Converter={StaticResource UriToBitmapConverter}}"
                     Width="15"
                     Height="15"
                     VerticalAlignment="Center" />
              <TextBlock Text="{Binding DisplayTitle}"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         FontSize="12" />
              <Button Classes="editor-close" Command="{Binding CloseCommand}" ToolTip.Tip="Close editor"
                      AutomationProperties.Name="Close editor">
                <Image Classes="editor-close-icon" Width="12" Height="12" />
              </Button>
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
        <TabControl.Template>
          <ControlTemplate>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ScrollViewer>
          </ControlTemplate>
        </TabControl.Template>
      </TabControl>

    <Menu Grid.Row="0" Name="ApplicationMenu">
      <MenuItem Classes="menu-bar-item" Header="File" ItemsSource="{Binding FileMenu.Items}" ItemContainerTheme="{StaticResource EditorMenuItemTheme}" />
      <MenuItem Classes="menu-bar-item" Header="Edit" ItemsSource="{Binding EditMenu.Items}" ItemContainerTheme="{StaticResource EditorMenuItemTheme}" />
      <MenuItem Classes="menu-bar-item" Header="View" ItemsSource="{Binding ViewMenu.Items}" ItemContainerTheme="{StaticResource EditorMenuItemTheme}" />
      <MenuItem Classes="menu-bar-item" Header="Element" IsVisible="{Binding ElementMenu.IsVisible}" ItemsSource="{Binding ElementMenu.Items}" ItemContainerTheme="{StaticResource EditorMenuItemTheme}" />
      <MenuItem Classes="menu-bar-item" Header="{Binding EditorMenu.Header}" IsVisible="{Binding EditorMenu.IsVisible}" ItemsSource="{Binding EditorMenu.Items}" ItemContainerTheme="{StaticResource EditorMenuItemTheme}" />
      <MenuItem Classes="menu-bar-item" Header="Tools" ItemsSource="{Binding ToolsMenu.Items}" ItemContainerTheme="{StaticResource EditorMenuItemTheme}" />
      <MenuItem Classes="menu-bar-item" Header="Editors" ItemsSource="{Binding EditorsMenu.Items}" ItemContainerTheme="{StaticResource EditorMenuItemTheme}" />
      <MenuItem Classes="menu-bar-item" Header="Help" ItemsSource="{Binding HelpMenu.Items}" ItemContainerTheme="{StaticResource EditorMenuItemTheme}" />
    </Menu>

    <workspace:WorkspaceView Grid.Row="2" LayoutKey="Shell" LeftTitle="Explorer" ShowLeft="{Binding IsAssetExplorerVisible}">
      <workspace:WorkspaceView.LeftContent>
        <explorer:AssetExplorerView DataContext="{Binding Explorer}" />
      </workspace:WorkspaceView.LeftContent>
      <workspace:WorkspaceView.CenterContent>
        <workspace:EditorHost ActiveDocument="{Binding ActiveDocument}" Documents="{Binding Documents}" />
      </workspace:WorkspaceView.CenterContent>
    </workspace:WorkspaceView>

    <!-- Legacy shell shortcuts and addon actions. -->
    <Border Grid.Row="3" Name="BottomBar" Classes="shell-bottom" Background="{DynamicResource H5TSurfaceBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
        <!-- Bottom left: structure warning (if wrong), update button (if available), and console line status. -->
        <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,*">
          <Button Grid.Column="0" Name="StructureWarningButton"
                  Command="{Binding ShowWarningsCommand}"
                  IsVisible="{Binding HasActiveWarnings}"
                  Classes="warning-badge"
                  ToolTip.Tip="{Binding WarningToolTip}"
                  Margin="4,0,4,0">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource H5TWarningBrush}" Data="{StaticResource H5TShellWarningIcon}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding WarningButtonText}" Foreground="{DynamicResource H5TWarningBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Grid.Column="1" Name="BottomUpdateButton"
                  Command="{Binding OpenUpdateCommand}"
                  IsVisible="{Binding IsUpdateAvailable}"
                  ToolTip.Tip="{Binding UpdateToolTip}"
                  Margin="0,0,4,0">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Path Classes="shell-icon" Data="{StaticResource H5TShellSyncIcon}" Fill="#4caf50" Width="14" Height="14" />
              <TextBlock Text="Update" Foreground="#4caf50" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Recent activity opens the console. -->
          <Border Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="8,0" ToolTip.Tip="Console activity — click to open Console">
            <Button Command="{Binding OpenConsoleCommand}" Classes="subtle shell-status" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource H5TTextMutedBrush}" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource H5TFontFamily}" />
              </Grid>
            </Button>
          </Border>
        </Grid>

        <!-- Utilities open dialogs and Workshop opens its editor tab. -->
        <Button Grid.Column="1" Width="90" ToolTip.Tip="Open tools">
          <Button.Content>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Path Classes="shell-icon" Data="{StaticResource H5TShellUtilitiesIcon}" />
              <TextBlock Text="Utilities" VerticalAlignment="Center" />
            </StackPanel>
          </Button.Content>
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="Map Builder" Command="{Binding OpenMapBuilderCommand}" />
              <MenuItem Header="Workshop Manager" Command="{Binding OpenWorkshopManagerCommand}" />
              <MenuItem Header="Asset Tools (Rename / Relink)" Command="{Binding OpenAssetToolsCommand}" />
              <MenuItem Header="NavMesh Radar" Command="{Binding OpenNavMeshRadarCommand}" />
              <Separator />
              <MenuItem Header="Git Sync" Command="{Binding OpenGitSyncCommand}" />
              <MenuItem Header="Console" Command="{Binding OpenConsoleCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Actions Menu Button (Folder navigation, refresh, cache, CS2 controls) -->
        <Button Grid.Column="2" x:Name="AddonActionsButton" Classes="shell-icon" ToolTip.Tip="Addon actions and tool settings">
          <Button.Content><Path Classes="shell-icon" Data="{StaticResource H5TShellMenuIcon}" /></Button.Content>
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="Edit launch parameters" Command="{Binding OpenPreferencesCommand}" />
              <Separator />
              <MenuItem Header="Create new addon" Command="{Binding CreateAddonCommand}" />
              <MenuItem Header="Remove addon" Command="{Binding RemoveAddonCommand}" />
              <Separator />
              <MenuItem Header="Export addon" Command="{Binding ExportAddonCommand}" />
              <MenuItem Header="Import addon" Command="{Binding ImportAddonCommand}" />
              <Separator />
              <MenuItem Header="Open content folder" Command="{Binding OpenContentFolderCommand}" />
              <MenuItem Header="Open game folder" Command="{Binding OpenGameFolderCommand}" />
              <MenuItem Header="Refresh addon list" Command="{Binding RefreshAddonsCommand}" />
                </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Addon Selector ComboBox -->
        <ComboBox Grid.Column="3"
                  ItemsSource="{Binding Addons}"
                  SelectedItem="{Binding SelectedAddon}"
                  Name="AddonSelector" Width="220"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Selected Addon workspace">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="addons:Addon">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Grid.Column="4" Name="LaunchAddonButton" MinWidth="128"
                Command="{Binding LaunchCs2Command}" ToolTip.Tip="Launch Hammer / CS2 Workshop Tools for the selected addon"
                AutomationProperties.Name="Edit map">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Source="avares://Hammer5Tools/Assets/Icons/hammer_icon.png" Width="20" Height="20" />
            <TextBlock Text="Edit map" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button Grid.Column="5" Name="GitSyncButton" Classes="shell-icon"
                Command="{Binding OpenGitSyncCommand}" ToolTip.Tip="Git Sync">
          <Path Classes="shell-icon" Data="{StaticResource H5TShellSyncIcon}" />
        </Button>

        <Button Grid.Column="6" Name="MapBuilderButton" Classes="shell-icon"
                Command="{Binding OpenMapBuilderCommand}" ToolTip.Tip="Map Builder: compile VMAP files">
          <Image Source="avares://Hammer5Tools/Assets/Icons/emoji_objects_24dp.png" Width="16" Height="16" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
