<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls">

  <!-- ========================================================================= -->
  <!-- Semantic Theme Palette & Design Factors from theme.py & STYLESHEET.md    -->
  <!-- ========================================================================= -->
  <Styles.Resources>
    <StreamGeometry x:Key="H5TShellUtilitiesIcon">M240-160q-33 0-56.5-23.5T160-240q0-33 23.5-56.5T240-320q33 0 56.5 23.5T320-240q0 33-23.5 56.5T240-160Zm240 0q-33 0-56.5-23.5T400-240q0-33 23.5-56.5T480-320q33 0 56.5 23.5T560-240q0 33-23.5 56.5T480-160Zm240 0q-33 0-56.5-23.5T640-240q0-33 23.5-56.5T720-320q33 0 56.5 23.5T800-240q0 33-23.5 56.5T720-160ZM240-400q-33 0-56.5-23.5T160-480q0-33 23.5-56.5T240-560q33 0 56.5 23.5T320-480q0 33-23.5 56.5T240-400Zm240 0q-33 0-56.5-23.5T400-480q0-33 23.5-56.5T480-560q33 0 56.5 23.5T560-480q0 33-23.5 56.5T480-400Zm240 0q-33 0-56.5-23.5T640-480q0-33 23.5-56.5T720-560q33 0 56.5 23.5T800-480q0 33-23.5 56.5T720-400ZM240-640q-33 0-56.5-23.5T160-720q0-33 23.5-56.5T240-800q33 0 56.5 23.5T320-720q0 33-23.5 56.5T240-640Zm240 0q-33 0-56.5-23.5T400-720q0-33 23.5-56.5T480-800q33 0 56.5 23.5T560-720q0 33-23.5 56.5T480-640Zm240 0q-33 0-56.5-23.5T640-720q0-33 23.5-56.5T720-800q33 0 56.5 23.5T800-720q0 33-23.5 56.5T720-640Z</StreamGeometry>
    <StreamGeometry x:Key="H5TShellMenuIcon">M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z</StreamGeometry>
    <StreamGeometry x:Key="H5TShellSyncIcon">M160-160v-80h110l-16-14q-52-46-73-105t-21-119q0-111 66.5-197.5T400-790v84q-72 26-116 88.5T240-478q0 45 17 87.5t53 78.5l10 10v-98h80v240H160Zm400-10v-84q72-26 116-88.5T720-482q0-45-17-87.5T650-648l-10-10v98h-80v-240h240v80H690l16 14q49 49 71.5 106.5T800-482q0 111-66.5 197.5T560-170Z</StreamGeometry>
    <SolidColorBrush x:Key="H5TPropertyFloatBrush" Color="#b5ffef" />
    <SolidColorBrush x:Key="H5TPropertyBoolBrush" Color="#ffbdbe" />
    <SolidColorBrush x:Key="H5TPropertyStringBrush" Color="#ffd199" />
    <SolidColorBrush x:Key="H5TPropertySectionBrush" Color="#b3d096" />
    <SolidColorBrush x:Key="H5TCpuChartBrush" Color="#ff5a5a" />
    <SolidColorBrush x:Key="H5TMemoryChartBrush" Color="#ffd700" />
    <SolidColorBrush x:Key="H5TGpuChartBrush" Color="#32b8c6" />
    <!-- Core Surface Palette -->
    <Color x:Key="H5TBackgroundColor">#2e2e2e</Color>
    <Color x:Key="H5TSurfaceColor">#272727</Color>
    <Color x:Key="H5TSurfaceRaisedColor">#2f2f31</Color>
    <Color x:Key="H5TSurfaceInputColor">#363637</Color>
    <Color x:Key="H5TConsoleBgColor">#1e1e1e</Color>

    <!-- Text Colors -->
    <Color x:Key="H5TTextColor">#e5e5e5</Color>
    <Color x:Key="H5TTextMutedColor">#a5a5a5</Color>
    <Color x:Key="H5TTextDisabledColor">#797979</Color>

    <!-- Borders -->
    <Color x:Key="H5TBorderColor">#464649</Color>
    <Color x:Key="H5TBorderStrongColor">#5e5e5e</Color>
    <Color x:Key="H5TBorderSubtleColor">#3f3f42</Color>

    <!-- Accents & Selections -->
    <Color x:Key="H5TAccentColor">#4a83c9</Color>
    <Color x:Key="H5TAccentHoverColor">#586776</Color>
    <Color x:Key="H5TAccentPressedColor">#6d7882</Color>
    <Color x:Key="H5TSelectionColor">#515965</Color>
    <Color x:Key="H5TSelectionTextColor">#ffffff</Color>

    <!-- Status Accents -->
    <Color x:Key="H5TErrorColor">#d1494a</Color>
    <Color x:Key="H5TWarningColor">#e5a00d</Color>
    <Color x:Key="H5TSuccessColor">#5ab55e</Color>
    <Color x:Key="H5TSuccessDarkColor">#2e7d32</Color>
    <Color x:Key="H5TErrorDarkColor">#c62828</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="H5TBackgroundBrush" Color="{StaticResource H5TBackgroundColor}" />
    <SolidColorBrush x:Key="H5TSurfaceBrush" Color="{StaticResource H5TSurfaceColor}" />
    <SolidColorBrush x:Key="H5TSurfaceRaisedBrush" Color="{StaticResource H5TSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="H5TSurfaceInputBrush" Color="{StaticResource H5TSurfaceInputColor}" />
    <SolidColorBrush x:Key="H5TConsoleBgBrush" Color="{StaticResource H5TConsoleBgColor}" />

    <SolidColorBrush x:Key="H5TTextBrush" Color="{StaticResource H5TTextColor}" />
    <SolidColorBrush x:Key="H5TTextMutedBrush" Color="{StaticResource H5TTextMutedColor}" />
    <SolidColorBrush x:Key="H5TTextDisabledBrush" Color="{StaticResource H5TTextDisabledColor}" />

    <SolidColorBrush x:Key="H5TBorderBrush" Color="{StaticResource H5TBorderColor}" />
    <SolidColorBrush x:Key="H5TBorderStrongBrush" Color="{StaticResource H5TBorderStrongColor}" />
    <SolidColorBrush x:Key="H5TBorderSubtleBrush" Color="{StaticResource H5TBorderSubtleColor}" />

    <SolidColorBrush x:Key="H5TAccentBrush" Color="{StaticResource H5TAccentColor}" />
    <SolidColorBrush x:Key="H5TAccentHoverBrush" Color="{StaticResource H5TAccentHoverColor}" />
    <SolidColorBrush x:Key="H5TAccentPressedBrush" Color="{StaticResource H5TAccentPressedColor}" />
    <SolidColorBrush x:Key="H5TSelectionBrush" Color="{StaticResource H5TSelectionColor}" />
    <SolidColorBrush x:Key="H5TSelectionTextBrush" Color="{StaticResource H5TSelectionTextColor}" />

    <SolidColorBrush x:Key="H5TErrorBrush" Color="{StaticResource H5TErrorColor}" />
    <SolidColorBrush x:Key="H5TWarningBrush" Color="{StaticResource H5TWarningColor}" />
    <SolidColorBrush x:Key="H5TSuccessBrush" Color="{StaticResource H5TSuccessColor}" />
    <SolidColorBrush x:Key="H5TSuccessDarkBrush" Color="{StaticResource H5TSuccessDarkColor}" />
    <SolidColorBrush x:Key="H5TErrorDarkBrush" Color="{StaticResource H5TErrorDarkColor}" />

    <!-- Design Factor Metrics -->
    <CornerRadius x:Key="H5TRadius">2</CornerRadius>
    <Thickness x:Key="H5TBorderThickness">2</Thickness>
    <x:Double x:Key="H5TControlHeight">22</x:Double>
    <FontFamily x:Key="H5TFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="H5TMonospaceFont">Consolas, Menlo, Monaco, Courier New, monospace</FontFamily>
  </Styles.Resources>

  <!-- ========================================================================= -->
  <!-- Window Default Styling                                                    -->
  <!-- ========================================================================= -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource H5TFontFamily}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ========================================================================= -->
  <!-- Button Styling (Matching buttons.qss: 2px radius, 1px strong border)     -->
  <!-- ========================================================================= -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource H5TRadius}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TDisabledBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderSubtleBrush}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Foreground" Value="{DynamicResource H5TButtonDisabledTextBrush}" />
  </Style>

  <!-- Button Variants -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource H5TAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TPrimaryBorderBrush}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TAccentHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
  </Style>

  <Style Selector="Button.success">
    <Setter Property="Background" Value="{DynamicResource H5TSuccessDarkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TSuccessBorderBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.success:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TSuccessHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource H5TErrorDarkBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TDangerBorderBrush}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TDangerHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderBrush}" />
  </Style>

  <!-- ========================================================================= -->
  <!-- TextBox / Inputs (Matching inputs.qss: surface_input, border, accent)     -->
  <!-- ========================================================================= -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceInputBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource H5TRadius}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="SelectionBrush" Value="{DynamicResource H5TSelectionBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border">
    <Setter Property="BorderBrush" Value="{DynamicResource H5TAccentBrush}" />
  </Style>

  <!-- ========================================================================= -->
  <!-- ComboBox (Matching inputs.qss: background #2e2e2e / surface_input)        -->
  <!-- ========================================================================= -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource H5TRadius}" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Normal" />
</Style>
  <Style Selector="ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource H5TSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
  </Style>

  <!-- ========================================================================= -->
  <!-- ListBox & Views (Matching views.qss: surface, selection #515965)          -->
  <!-- ========================================================================= -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{StaticResource H5TRadius}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TRowHoverBrush}" />
  </Style>

  <!-- ========================================================================= -->
  <!-- Menu Bar & ContextMenu (Matching menus.qss: surface #272727, hover #515965) -->
  <!-- ========================================================================= -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceBrush}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="MenuItem.menu-bar-item">
    <Setter Property="Padding" Value="7,1" />
  </Style>
  <Style Selector="MenuItem.menu-popup-item">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="MinHeight" Value="20" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource H5TSelectionBrush}" />
  </Style>
  <Style Selector="ContextMenu, MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource H5TRadius}" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- ========================================================================= -->
  <!-- TabControl (Matching tabs.qss: surface_raised pane, 2px top accent on sel) -->
  <!-- ========================================================================= -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceRaisedBrush}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource H5TTextMutedBrush}" />
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceBrush}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="TabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceInputBrush}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TAccentBrush}" />
  </Style>

  <!-- ========================================================================= -->
  <!-- ToolTip Styling (Matching base.qss: background, strong border, padding)    -->
  <!-- ========================================================================= -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource H5TRadius}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ========================================================================= -->
  <!-- Separator & Dividers                                                      -->
  <!-- ========================================================================= -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{DynamicResource H5TBorderBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,2" />
  </Style>

  <!-- ========================================================================= -->
  <!-- ScrollBar Styling (Matching base.qss: handle selection #515965)           -->
  <!-- ========================================================================= -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceBrush}" />
  </Style>

  <!-- ========================================================================= -->
  <!-- Typography & Helper Classes                                              -->
  <!-- ========================================================================= -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource H5TTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource H5TAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource H5TSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource H5TErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource H5TWarningBrush}" />
  </Style>
  <Style Selector="TextBlock.header">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource H5TMonospaceFont}" />
  </Style>

  <Style Selector="TextBlock.section"><Setter Property="FontWeight" Value="Bold" /><Setter Property="Margin" Value="0,6,0,2" /></Style>
  <Style Selector="dock|ToolChromeControl /template/ Button">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="CheckBox:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TSelectionBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TSelectionTextBrush}" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TreeView">
    <Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource H5TTextBrush}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource H5TSelectionBrush}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource H5TBorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
          <Border Name="PART_BaselineAccent" Background="{DynamicResource H5TAccentBrush}"
                  Height="2" VerticalAlignment="Top" Margin="1,0" IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="CornerRadius" Value="2,2,0,0" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_BaselineAccent">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="dock|ToolChromeControl /template/ Button">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="dock|ToolChromeControl /template/ TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="Border.editor-panel">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBlock.column-header">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceRaisedBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.bindings ListBoxItem">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.bindings ListBoxItem:nth-child(2n)">
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceInputBrush}" />
  </Style>
  <Style Selector="ListBox.build-presets">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.build-presets ListBoxItem">
    <Setter Property="Width" Value="64" /><Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Background" Value="{DynamicResource H5TSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.build-presets ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource H5TAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource H5TBorderStrongBrush}" />
  </Style>
  <Style Selector="Expander.map-group">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <ToggleButton Name="PART_Header" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="32"
                        Padding="8,0" Background="{DynamicResource H5TSurfaceRaisedBrush}" BorderThickness="0">
            <Grid ColumnDefinitions="*,24">
              <TextBlock Text="{TemplateBinding Header}" FontSize="16" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border Grid.Column="1" BorderBrush="{DynamicResource H5TBorderStrongBrush}" BorderThickness="2" Height="24" Width="24"><TextBlock Text="▾" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Grid>
          </ToggleButton>
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" IsVisible="{TemplateBinding IsExpanded}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Expander.map-group /template/ ToggleButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource H5TSurfaceRaisedBrush}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="CheckBox.map-option"><Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="CheckBox.map-option:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="ListBox.map-list"><Setter Property="Background" Value="{DynamicResource H5TSurfaceRaisedBrush}" /></Style>
  <Style Selector="ListBox.build-output"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBox.build-output ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="18" /></Style>
  <Style Selector="TextBlock.log-error"><Setter Property="Foreground" Value="{DynamicResource H5TErrorBrush}" /></Style>
  <Style Selector="TextBlock.log-warning"><Setter Property="Foreground" Value="{DynamicResource H5TWarningBrush}" /></Style>
  <Style Selector="TextBlock.log-phase"><Setter Property="Foreground" Value="{DynamicResource H5TAccentBrush}" /></Style>
  <Style Selector="Border.build-log"><Setter Property="Background" Value="{DynamicResource H5TBackgroundBrush}" /></Style>
  <Style Selector="NumericUpDown.compact"><Setter Property="Height" Value="26" /></Style>
  <Style Selector="Button"><Setter Property="HorizontalContentAlignment" Value="Center" /></Style>
  <Style Selector="Slider.h5-slider:horizontal">
    <Setter Property="Template">
      <ControlTemplate>
        <Grid><Border Height="8" VerticalAlignment="Center" Background="{DynamicResource H5TSurfaceRaisedBrush}" BorderBrush="{DynamicResource H5TBorderStrongBrush}" BorderThickness="2" /><Track Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
               Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}"
               IsDirectionReversed="{TemplateBinding IsDirectionReversed}" VerticalAlignment="Center" Height="18">
          <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Opacity="0" Classes="slider-track" /></Track.DecreaseButton>
          <Track.Thumb><Thumb Name="PART_Thumb" Width="8" Height="16"><Thumb.Template><ControlTemplate><Border Name="SliderThumbBody" Background="{DynamicResource H5TSelectionBrush}" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Opacity="0" Classes="slider-track" /></Track.IncreaseButton>
        </Track></Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RepeatButton.slider-track">
    <Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="0" />
    <Setter Property="Template"><ControlTemplate><Border Height="8" Background="{DynamicResource H5TSurfaceRaisedBrush}" BorderBrush="{DynamicResource H5TBorderStrongBrush}" BorderThickness="2" /></ControlTemplate></Setter>
  </Style>
  <Style Selector="Slider /template/ Thumb">
    <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" /></ControlTemplate></Setter>
  </Style>
  <Style Selector="Slider:pointerover /template/ Thumb"><Setter Property="Background" Value="{DynamicResource H5TAccentHoverBrush}" /></Style>
  <Style Selector="Slider:focus-visible /template/ Thumb"><Setter Property="Background" Value="{DynamicResource H5TAccentBrush}" /></Style>
  <Style Selector="Slider:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="TextBlock.property-section"><Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Margin" Value="0,10,0,4" /><Setter Property="Foreground" Value="{DynamicResource H5TPropertySectionBrush}" /></Style>
  <Style Selector="TextBlock.property-float"><Setter Property="Foreground" Value="{DynamicResource H5TPropertyFloatBrush}" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="TextBlock.property-bool"><Setter Property="Foreground" Value="{DynamicResource H5TPropertyBoolBrush}" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="TextBlock.property-string"><Setter Property="Foreground" Value="{DynamicResource H5TPropertyStringBrush}" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="NumericUpDown.compact">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="NumericFrame" Background="{DynamicResource H5TSurfaceRaisedBrush}" BorderBrush="{DynamicResource H5TBorderStrongBrush}" BorderThickness="2">
          <ButtonSpinner Name="PART_Spinner" AllowSpin="{TemplateBinding AllowSpin}" ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}">
            <ButtonSpinner.Template>
              <ControlTemplate>
                <DockPanel LastChildFill="True">
                  <Grid DockPanel.Dock="Right" Width="14" RowDefinitions="*,*" IsVisible="{TemplateBinding ShowButtonSpinner}">
                    <RepeatButton Name="PART_IncreaseButton" Classes="numeric-arrow"><Path Width="6" Height="3" Stretch="Fill" Data="M 0,3 L 3,0 L 6,3 Z" Fill="{DynamicResource H5TTextMutedBrush}" /></RepeatButton>
                    <RepeatButton Name="PART_DecreaseButton" Grid.Row="1" Classes="numeric-arrow"><Path Width="6" Height="3" Stretch="Fill" Data="M 0,0 L 3,3 L 6,0 Z" Fill="{DynamicResource H5TTextMutedBrush}" /></RepeatButton>
                  </Grid>
                  <ContentPresenter Content="{TemplateBinding Content}" />
                </DockPanel>
              </ControlTemplate>
            </ButtonSpinner.Template>
            <TextBox Name="PART_TextBox" Text="{TemplateBinding Text, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="8,0" MinWidth="0" Margin="0" MinHeight="22" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" />
          </ButtonSpinner>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RepeatButton.numeric-arrow">
    <Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="0" />
    <Setter Property="Template"><ControlTemplate><Border Background="{DynamicResource H5TSurfaceRaisedBrush}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" /></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="NumericUpDown.compact:focus-within /template/ Border#NumericFrame"><Setter Property="BorderBrush" Value="{DynamicResource H5TAccentBrush}" /></Style>

  <Style Selector="Border.shell-bottom Button">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Border.shell-bottom Button.shell-icon">
    <Setter Property="Width" Value="26" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.shell-bottom Button.shell-status">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="Border.shell-bottom TextBlock">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.shell-bottom ComboBox">
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Border.shell-bottom Path.shell-icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Fill" Value="{DynamicResource H5TTextMutedBrush}" />
  </Style>
</Styles>
