/* QProgressBar, QListWidget, QListView, QHeaderView, QTableWidget/View,
   QTreeView. Split out of qt_global_stylesheet.py during the
   styling-refactor migration. Behavior preserved as-is. */

QProgressBar {
    border: 2px solid #5ab55e;
    border-radius: 5px;
    text-align: center;
    color: @text_primary;
    background-color: @background_primary;
    font: 700 10pt "Segoe UI";
    border: 2px solid black;
    border-radius: 4px;
    border-color: rgba(94, 94, 94, 255);
}

QProgressBar::chunk {
    background-color: @selected_fill;
    width: 20px;
    margin: 1px;
    border-radius: 2px;
}

QListWidget {
    border: 2px solid #d0d0d0;
    border-color: rgba(94, 94, 94, 255);
    border-radius: 2px;
    padding: 2px;
    color: @text_primary;
    background-color: @background_secondary;
    show-decoration-selected: 1;
}
QListWidget::item {
    padding: 2px;
    alternate-background-color: #ff363636;
}
QListWidget::item:selected {
    background-color: @selected_fill;
    color: white;
}

QListWidget::item:hover {
    background-color: @selected_fill;
}

QListView {
    border: 2px solid #d0d0d0;
    border-color: rgba(94, 94, 94, 255);
    border-radius: 2px;
    padding: 2px;
    color: @text_primary;
    background-color: @background_secondary;
    show-decoration-selected: 1;
}
QListView::item {
    padding: 0px;
}
QListView::item:selected {
    background-color: @selected_fill;
    color: white;
}

QListView::item:hover {
    background-color: @selected_fill;
}

QHeaderView::section {
    background-color: @background_primary;
    color: @text_neutral;
    padding: 5px;
    border: none;
    font: 600 10pt "Segoe UI";
}
QTableWidget, QTableView {
    border: none;
    background-color: @background_neutral;
    color: @text_primary;
    gridline-color: #3e3e41;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 5px;
    border-bottom: 1px solid #3e3e41;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: @selected_fill;
    color: white;
}
QTableView QTableCornerButton::section {
    background-color: @background_primary;
    border: none;
}

QTreeView {
    color: @text_primary;
    border: 2px solid black;
    border-radius: 1px;
    border-color: rgba(94, 94, 94, 255);
    font: 580 10pt "Segoe UI";
    background-color: @background_neutral;
    alternate-background-color: #ff363636;
}

QTreeView::item {
    padding-left: 1px;
    padding-right: 1px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-style: none;
    border-bottom: 0.5px solid black;
    border-color: rgba(255, 255, 255, 10);
}

QTreeView::item:selected {
    background-color: @selected_fill;
    alternate-background-color: @selected_fill;
    color: white;
}

QTreeView::item:hover {
    background-color: #38383a;
    color: @text_primary;
}

QTreeView::branch:has-siblings {
    border-image: url(:/icons/vertical_line.png) 0;
}

QTreeView::branch:has-siblings:adjoins-item {
    border-image: none;
}

QTreeView::branch:closed:has-children {
     image: url(:/icons/arrow_right_16dp.svg);
}

QTreeView::branch:open:has-children {
    image: url(:/icons/arrow_drop_down_16dp.svg);
}

/* Remove border for edit line in tree */
QTreeView::item QLineEdit {
    border: none;
    margin: 0px;
    padding: 0px;
    background-color: @background_primary;
    color: @text_primary;
}

QHeaderView::section {
    background-color: @background_secondary;
    color: @text_primary;
    font: 600 10pt "Segoe UI";
    height: 16px;
    border: 0px;
    border-bottom: 2px solid black;
    border-radius: 2px;
    border-color: rgba(94, 94, 94, 255);
}
