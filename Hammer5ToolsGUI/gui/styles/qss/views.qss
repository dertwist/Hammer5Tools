/* QProgressBar, QListWidget, QListView, QHeaderView, QTableWidget/View,
   QTreeView. Split out of qt_global_stylesheet.py during the
   styling-refactor migration. Behavior preserved as-is. */

QProgressBar {
    border: 1px solid @hex_5e5e5e;
    border-radius: 2px;
    text-align: center;
    color: white;
    font-size: 10px;
    background-color: @background;
}

QProgressBar::chunk {
    background-color: @hex_1a528a;
    margin: 0px;
    width: 1px;
}

QListWidget {
    border: 2px solid @hex_d0d0d0;
    border-color: @rgba_5e5e5e_255;
    border-radius: 2px;
    padding: 2px;
    color: @text;
    background-color: @surface_raised;
    show-decoration-selected: 1;
}
QListWidget::item {
    padding: 2px;
    alternate-background-color: @hex_363636;
}
QListWidget::item:selected {
    background-color: @selection;
    color: @selection_text;
}

QListWidget::item:hover {
    background-color: @selection;
}

QListView {
    border: 2px solid @hex_d0d0d0;
    border-color: @rgba_5e5e5e_255;
    border-radius: 2px;
    padding: 2px;
    color: @text;
    background-color: @surface_raised;
    show-decoration-selected: 1;
}
QListView::item {
    padding: 0px;
}
QListView::item:selected {
    background-color: @selection;
    color: @selection_text;
}

QListView::item:hover {
    background-color: @selection;
}

QHeaderView::section {
    background-color: @background;
    color: @text_muted;
    padding: 5px;
    border: none;
    font: 600 10pt "Segoe UI";
}
QTableWidget, QTableView {
    border: none;
    background-color: @surface;
    color: @text;
    gridline-color: @hex_3e3e41;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 5px;
    border-bottom: 1px solid @hex_3e3e41;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: @selection;
    color: @selection_text;
}
QTableView QTableCornerButton::section {
    background-color: @background;
    border: none;
}

QTreeView {
    color: @text;
    border: 2px solid black;
    border-radius: 1px;
    border-color: @rgba_5e5e5e_255;
    font: 580 10pt "Segoe UI";
    background-color: @surface;
    alternate-background-color: @hex_363636;
}

QTreeView::item {
    padding-left: 1px;
    padding-right: 1px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-style: none;
    border-bottom: 0.5px solid black;
    border-color: @rgba_ffffff_10;
}

QTreeView::item:selected {
    background-color: @selection;
    alternate-background-color: @selection;
    color: @selection_text;
}

QTreeView::item:hover {
    background-color: @hex_38383a;
    color: @text;
}

QTreeView::branch:has-siblings {
    border-image: url(:/icons/vertical_line.png) 0;
}

QTreeView::branch:has-siblings:adjoins-item {
    border-image: none;
}

QTreeView::branch:closed:has-children {
     image: url(:/icons/arrow_right_16dp.svg);
}

QTreeView::branch:open:has-children {
    image: url(:/icons/arrow_drop_down_16dp.svg);
}

/* Remove border for edit line in tree */
QTreeView::item QLineEdit {
    border: none;
    margin: 0px;
    padding: 0px;
    background-color: @background;
    color: @text;
}

QHeaderView::section {
    background-color: @surface_raised;
    color: @text;
    font: 600 10pt "Segoe UI";
    height: 16px;
    border: 0px;
    border-bottom: 2px solid black;
    border-radius: 2px;
    border-color: @rgba_5e5e5e_255;
}
