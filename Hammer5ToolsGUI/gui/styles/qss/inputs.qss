/* QComboBox, QCheckBox, QRadioButton, QLineEdit, QTextEdit, QPlainTextEdit,
   QTextBrowser, QSpinBox, QDoubleSpinBox. Split out of
   qt_global_stylesheet.py during the styling-refactor migration. Behavior
   preserved as-is, including the pre-existing duplicate QPlainTextEdit /
   QTextBrowser blocks (harmless — later identical selectors just re-apply
   the same rule) and the pre-existing dead QPlainTextEdit:hover comment. */

QComboBox {
    font: 580 9pt "Segoe UI";
    border: 2px solid black;
    border-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    height: 22px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    color: @text;
    background-color: @background;
}
QComboBox:hover {
    background-color: @selection;
    color: @selection_text;
}
QComboBox:pressed {
    background-color: @selection;
    color: @selection_text;
}

QComboBox::drop-down {
    color: @text;
    padding: 2px;
    background: url(://icons/arrow_drop_down_16dp.svg) no-repeat center;
    border-bottom: 0px solid black;
    border-top: 0px solid black;
    border-right: 0px;
    border-left: 2px solid;
    margin-left: 5px;
    padding: 5px;
    width: 7px;
    border-color: @rgba_5e5e5e_255;
    background-color: @background;
}

/* Popup mirrors the QMenu look from menus.qss, plus alternating rows. */
QComboBox QAbstractItemView {
    qproperty-alternatingRowColors: true;
    background-color: @surface_raised;
    alternate-background-color: @surface_input;
    border: 2px solid black;
    border-radius: 1px;
    border-color: @rgba_5e5e5e_255;
    selection-background-color: @selection;
    color: @text;
    outline: 0px;
    padding: 0px;
}

QComboBox QAbstractItemView::item {
    font: 600 10pt "Segoe UI";
    background-color: @surface_raised;
    border: 1px solid transparent;
    border-radius: 1px;
    border-top: 0px;
    border-bottom: 2px solid transparent;
    border-color: @rgba_5e5e5e_105;
    padding: 4px 8px 4px 8px;
    color: @text;
}

QComboBox QAbstractItemView::item:alternate {
    background-color: @surface_input;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @selection;
    color: @selection_text;
    border: 1px solid transparent;
    border-radius: 1px;
    border-top: 0px;
    border-bottom: 2px solid transparent;
    border-color: @rgba_5e5e5e_105;
}

QComboBox QAbstractItemView::item:disabled {
    color: @text_disabled;
    background-color: transparent;
}

QComboBox:disabled {
    background-color: @hex_2a2a2c;
    color: @hex_727272;
    border-color: @hex_3b3b3e;
}


QCheckBox {
    font: 580 10pt "Segoe UI";
    border: 2px solid black;
    border-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    height: 22px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    color: @text;
    background-color: @background;
}

QCheckBox::indicator:unchecked {
    image: url(://icons/check_box_outline_blank_16dp.svg);
}

QCheckBox::indicator:checked {
    image: url(://icons/select_check_box_16dp.svg);
}

QCheckBox:hover {
    background-color: @selection;
    color: @selection_text;
}
QCheckBox:disabled {
    color: @hex_727272;
}

QRadioButton {
    font: 580 10pt "Segoe UI";
    border: 2px solid black;
    border-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    height: 22px;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
    color: @text;
    background-color: @background;
}

QRadioButton::indicator:unchecked {
    image: url(://icons/radio_button_unchecked_24dp.svg);
    width: 16px;
    height: 16px;
}

QRadioButton::indicator:checked {
    image: url(://icons/radio_button_checked_24dp.svg);
    width: 16px;
    height: 16px;
}

QRadioButton:hover {
    background-color: @selection;
    color: @selection_text;
    border-radius: 2px;
}
QRadioButton:disabled {
    color: @hex_727272;
}

QListView {
    background-color: @surface_raised;
    border: 0px;
    border-radius: 4px;
    font: 600 11pt "Segoe UI";
    color: @hex_a2a79a;
    padding: 2px;
}

QPlainTextEdit,
QTextBrowser,
QTextEdit {
    font: 580 10pt "Segoe UI";
    border: 2px solid black;
    border-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    padding: 4px 6px;
    color: @text;
    background-color: @background;
    selection-background-color: @selection;
    selection-color: @selection_text;
}

QPlainTextEdit:focus,
QTextBrowser:focus,
QTextEdit:focus {
    border: 2px solid @hex_1495c0;
    border-color: @rgba_5e5e5e_255;
    background-color: @background;
}

QPlainTextEdit::selection,
QTextBrowser::selection,
QTextEdit::selection {
    background-color: @selection;
    color: @selection_text;
}

QLineEdit {
    border: 2px solid @hex_d0d0d0;
    border-color: @rgba_5e5e5e_255;
    border-radius: 2px;
    padding: 2px;
    color: @text;
}
QLineEdit:focus {
    border: 2px solid @hex_1495c0;
    border-color: @rgba_5e5e5e_255;
}
QLineEdit::selection {
    background-color: @selection;
    color: @selection_text;
}

QSpinBox {
    font: 580 10pt "Segoe UI";
    border: 2px solid black;
    border-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    padding-left: 2px;
    padding-right: 2px;
    color: @text;
    background-color: @background;
}

QSpinBox:focus {
}

QSpinBox:hover {
}

QSpinBox:pressed {
    background-color: @hex_252525;
}

QSpinBox::up-button {
    border: 0px solid black;
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-left: 2px solid black;
    border-bottom: 0px solid black;
    border-top-right-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    width: 16px;
    margin: 0px;
}

QSpinBox::up-arrow {
    image: url(://icons/arrow_drop_up_24dp.svg);
    width: 20px;
    height: 20px;
}

QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border: 0px solid black;
    border-left: 2px solid black;
    border-top: 2px solid black;
    border-bottom-right-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    width: 16px;
    margin: 0px;
}

QSpinBox::down-arrow {
    image: url(://icons/arrow_drop_down_16dp.svg);
    width: 20px;
    height: 20px;
}

QDoubleSpinBox {
    font: 580 10pt "Segoe UI";
    border: 2px solid black;
    border-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    padding-left: 2px;
    padding-right: 2px;
    color: @text;
    background-color: @background;
}

QDoubleSpinBox:focus {
}

QDoubleSpinBox:hover {
}

QDoubleSpinBox:pressed {
    background-color: @hex_252525;
}

QDoubleSpinBox::up-button {
    border: 0px solid black;
    subcontrol-origin: border;
    subcontrol-position: top right;
    border-left: 2px solid black;
    border-bottom: 0px solid black;
    border-top-right-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    width: 16px;
    margin: 0px;
}

QDoubleSpinBox::up-arrow {
    image: url(://icons/arrow_drop_up_24dp.svg);
    width: 20px;
    height: 20px;
}

QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    border: 0px solid black;
    border-left: 2px solid black;
    border-top: 2px solid black;
    border-bottom-right-radius: 2px;
    border-color: @rgba_5e5e5e_255;
    width: 16px;
    margin: 0px;
}

QDoubleSpinBox::down-arrow {
    image: url(://icons/arrow_drop_down_16dp.svg);
    width: 20px;
    height: 20px;
}
