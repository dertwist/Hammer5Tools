QFrame#frame > QPushButton#add_button,
QFrame#frame > QPushButton#paste_button {
    font: 580 8pt "Segoe UI";
    border: 2px solid black;
    border-color: @rgba_5e5e5e_255;
    border-top: 0px;
    border-left: 0px;
    border-right: 0px;
    height: 14px;
    padding-top: 2px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    color: @text;
    background-color: @hex_363636;
}
QFrame#frame > QPushButton#add_button:hover,
QFrame#frame > QPushButton#paste_button:hover {
    background-color: @selection;
    color: white;
}
QFrame#frame > QPushButton#add_button:pressed,
QFrame#frame > QPushButton#paste_button:pressed {
    font: 580 8pt "Segoe UI";
    border: 2px solid black;
    border-radius: 0px;
    border-color: @rgba_5e5e5e_255;
    border-top: 0px;
    border-left: 0px;
    border-right: 0px;
    height: 14px;
    padding-top: 2px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    color: @text;
    background-color: @hex_363636;
}

QFrame#frame_layout {
    border: 0px;
    border-top: 2px solid @rgba_5e5e5e_255;
}

QFrame#frame_3,
QFrame#hide_expression_frame {
    font: 580 10pt "Segoe UI";
    border: 2px solid black;
    border-radius: 0px;
    border-left: 0px;
    border-right: 0px;
    border-top: 0px;
    border-color: @rgba_424242_255;
    color: @text;
    background-color: @background;
}
QFrame#frame_3 QLabel#label_2,
QFrame#hide_expression_frame QLabel#label_3 {
    border: 0px;
    background-color: transparent;
    font: 8pt "Segoe UI";
}
QFrame#frame_3 QLineEdit#varialbe_display_name {
    border: 0px solid @hex_d0d0d0;
    border-color: @rgba_5e5e5e_255;
    border-radius: 2px;
    padding: 2px;
    color: @text;
    background-color: @background;
}

QPushButton[h5Component="smartpropColorSwatch"] {
    padding: 4px;
    border: 2px solid @rgba_5e5e5e_100;
}

/* props/note.py: sticky-note-styled comment editor. Deliberately not
   theme-gray (yellow sticky-note look, constant across themes)
   except the text-selection color, which matches @selection. */
QPlainTextEdit[h5Component="smartpropNoteEdit"] {
    background-color: @hex_fff8be;
    color: @hex_1e1e1e;
    border: 1px solid @hex_e0d28a;
    border-radius: 2px;
    font-family: "Segoe UI";
    font-size: 11px;
    padding: 4px 6px;
    selection-background-color: @selection;
    selection-color: @selection_text;
}
QPlainTextEdit[h5Component="smartpropNoteEdit"] QScrollBar:vertical {
    width: 6px;
    background: transparent;
}
QPlainTextEdit[h5Component="smartpropNoteEdit"] QScrollBar::handle:vertical {
    background: @hex_b0a66e;
    border-radius: 0px;
}

/* props/panel.py: collapsible section header, and the main panel's splitter. */
QFrame[h5Component="smartpropSectionHeader"] {
    background-color: @background;
    border: none;
    border-bottom: 2px solid @rgba_5e5e5e_255;
    border-radius: 0px;
}
QFrame[h5Component="smartpropSectionHeader"]:hover {
    background-color: @selection;
}
QToolButton[h5Component="smartpropSectionToggleBtn"] {
    background: transparent;
    border: none;
    text-align: left;
    color: @text;
    font: 580 9pt "Segoe UI";
    padding: 0px 4px;
}
QToolButton[h5Component="smartpropSectionToggleBtn"]:hover {
    color: @selection_text;
}
/* widgets/expression_editor/main.py: Expression Editor dialog. */
QLabel[h5Component="smartpropExprSectionLabel"] {
    color: @text;
}
QFrame[h5Component="smartpropExprRightPanel"] {
    background-color: @hex_363637;
    border: 1px solid @hex_4f4f4f;
    border-radius: 4px;
}
QLabel[h5Component="smartpropExprHelpLabel"] {
    color: @hex_d0d0d0;
    font-size: 8pt;
    padding: 8px;
    background-color: @hex_3e3e3e;
    border: 1px solid @hex_4f4f4f;
    border-radius: 3px;
    line-height: 1.4;
}
