/* props/note.py: sticky-note-styled comment editor. Deliberately not
   theme-gray (yellow sticky-note look, constant across themes)
   except the text-selection color, which matches @selection. */
QPlainTextEdit[h5Component="smartpropNoteEdit"] {
    background-color: @hex_fff8be;
    color: @hex_1e1e1e;
    border: 1px solid @hex_e0d28a;
    border-radius: 2px;
    font-family: "Segoe UI";
    font-size: 11px;
    padding: 4px 6px;
    selection-background-color: @selection;
    selection-color: @selection_text;
}
QPlainTextEdit[h5Component="smartpropNoteEdit"] QScrollBar:vertical {
    width: 6px;
    background: transparent;
}
QPlainTextEdit[h5Component="smartpropNoteEdit"] QScrollBar::handle:vertical {
    background: @hex_b0a66e;
    border-radius: 0px;
}

