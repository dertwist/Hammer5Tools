/* variables: Float, Int, Bool, Combobox, Vector, Color, Material, Model, etc. body editors */
QWidget[h5Component="smartpropVariableBody"] {
    font: 580 10pt "Segoe UI";
    background-color: @background;
    /* Was the .QWidget Designer sheet's padding, dropped when compile_ui.py
       started stripping those; without it the editors sit flush to the panel. */
    padding: 8px;
    padding-left: 6px;
    padding-right: 6px;
}
QWidget[h5Component="smartpropVariableBody"] QFrame {
    font: 580 10pt "Segoe UI";
    border: 2px solid black;
    border-color: @rgba_424242_255;
    border-top: 0px;
    border-left: 0px;
    border-right: 0px;
    border-bottom: 2px solid @rgba_424242_255;
    border-radius: 0px;
    background-color: @background;
    /* No colour on the containers either: Qt propagates a styled ancestor's
       colour down to children, and that beat the [h5ColorRole] rule on the
       labels inside these frames. The frames draw no text of their own. */
}
QWidget[h5Component="smartpropVariableBody"] QLabel {
    border: 0px;
    background-color: transparent;
    font: 8pt "Segoe UI";
    /* No colour here: it would outrank the [h5ColorRole] rules below, which is
       how the variable editors ended up with uniformly white field labels
       while the property rows were colour-coded by type. */
}
QWidget[h5Component="smartpropVariableBody"] QSpinBox,
QWidget[h5Component="smartpropVariableBody"] QDoubleSpinBox {
    font: 580 8pt "Segoe UI";
    border: 0px;
    border-radius: 2px;
    color: @text;
    background-color: @background;
}
QWidget[h5Component="smartpropVariableBody"] QSpinBox:disabled,
QWidget[h5Component="smartpropVariableBody"] QDoubleSpinBox:disabled {
    color: @text_disabled;
}
QWidget[h5Component="smartpropVariableBody"] QSpinBox:pressed,
QWidget[h5Component="smartpropVariableBody"] QDoubleSpinBox:pressed {
    background-color: @hex_252525;
}
QWidget[h5Component="smartpropVariableBody"] QSpinBox::up-button,
QWidget[h5Component="smartpropVariableBody"] QDoubleSpinBox::up-button {
    border: 0px solid black;
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    margin: 0px;
}
QWidget[h5Component="smartpropVariableBody"] QSpinBox::up-arrow,
QWidget[h5Component="smartpropVariableBody"] QDoubleSpinBox::up-arrow {
    image: url(://icons/arrow_drop_up_24dp.svg);
    width: 20px;
    height: 20px;
}
QWidget[h5Component="smartpropVariableBody"] QSpinBox::down-button,
QWidget[h5Component="smartpropVariableBody"] QDoubleSpinBox::down-button {
    border: 0px solid black;
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    margin: 0px;
}
QWidget[h5Component="smartpropVariableBody"] QSpinBox::down-arrow,
QWidget[h5Component="smartpropVariableBody"] QDoubleSpinBox::down-arrow {
    image: url(://icons/arrow_drop_down_16dp.svg);
    width: 20px;
    height: 20px;
}
QWidget[h5Component="smartpropVariableBody"] QCheckBox {
    font: 580 8pt "Segoe UI";
    border-radius: 0px;
    border: 0px;
    height: 14px;
    background-color: @background;
}
QWidget[h5Component="smartpropVariableBody"] QCheckBox::indicator:unchecked {
    image: url(://icons/check_box_outline_blank_16dp.svg);
}
QWidget[h5Component="smartpropVariableBody"] QCheckBox::indicator:checked {
    image: url(://icons/select_check_box_16dp.svg);
}
QWidget[h5Component="smartpropVariableBody"] QLineEdit {
    font: 8pt "Segoe UI";
    border: 0px;
    border-radius: 2px;
    padding: 2px;
    color: @text;
    background-color: @background;
}
QWidget[h5Component="smartpropVariableBody"] QLineEdit:focus {
    border-color: @rgba_5e5e5e_255;
}
QWidget[h5Component="smartpropVariableBody"] QLineEdit::selection {
    background-color: @selection;
    color: @selection_text;
}
QWidget[h5Component="smartpropVariableBody"] QComboBox {
    font: 8pt "Segoe UI";
    border: 0px;
    border-radius: 2px;
    padding: 2px;
    color: @text;
    background-color: @background;
}
QWidget[h5Component="smartpropVariableBody"] QComboBox:hover {
    background-color: @selection;
    color: @selection_text;
}
QWidget[h5Component="smartpropVariableBody"] QComboBox::drop-down {
    width: 16px;
    border: 0px;
    background: url(://icons/arrow_drop_down_16dp.svg) no-repeat center;
}
QWidget[h5Component="smartpropVariableBody"] QPushButton {
    font: 580 8pt "Segoe UI";
    border: 1px solid @rgba_5e5e5e_255;
    border-radius: 2px;
    padding: 2px 6px;
    color: @text;
    background-color: @background;
}
QWidget[h5Component="smartpropVariableBody"] QPushButton:hover {
    background-color: @selection;
    color: @selection_text;
}

QPushButton[h5Component="smartpropColorSwatch"] {
