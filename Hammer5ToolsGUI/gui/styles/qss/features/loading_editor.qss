
QLabel[h5Component="loadingImagePreview"],
QScrollArea[h5Component="loadingImageScroll"] {
    border: none;
    background: transparent;
    outline: none;
}
QLabel[h5Component="loadingSectionCount"] {
    color: @text_muted;
}
QToolButton[h5Component="loadingSectionFolderButton"] {
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
}
QToolButton[h5Component="loadingSectionFolderButton"]:hover {
    background-color: @rgba_ffffff_40;
    border-radius: 2px;
}
QTreeView[h5Component="loadingImageTree"] {
    outline: none;
}

QFrame[h5Component="loadingSvgDropArea"] {
    border: 1px dashed @border_strong;
    border-radius: 4px;
    background-color: @surface_input;
}
QFrame[h5Component="loadingSvgDropArea"][h5DragOver="true"] {
    border-color: @accent;
    background-color: @surface_raised;
}
QFrame[h5Component="loadingSvgDropArea"] QLabel,
QFrame[h5Component="loadingSvgDropArea"] QSvgWidget,
QFrame[h5Component="loadingSvgDropArea"] > QWidget {
    background: transparent;
}
QLabel[h5Component="loadingSvgDropLabel"] {
    color: @text_muted;
    font-size: 11px;
    background: transparent;
}
QLabel[h5Component="loadingSvgTips"] {
    color: @text_muted;
    font-size: 11px;
}
