/* One-off dialogs/forms migrated off inline setStyleSheet() calls during the
   styling-refactor plan. Grouped here (rather than one file per form) since
   each only contributes a handful of rules. */

QMainWindow[h5Component="detailPropEditorWindow"] {
    background-color: @surface;
}
QLabel[h5Component="detailPropSummaryLabel"] {
    color: @hex_aaaaaa;
    font: 8pt "Segoe UI";
    padding: 8px 6px;
}
QWidget[h5Component="assetManagerWindow"] {
    background-color: @surface;
}

/* forms/cleanup/main.py: compilation-check dialog. */
QLabel[h5Component="cleanupTitle"] {
    font-size: 20px;
    font-weight: bold;
    color: @text;
}
QLabel[h5Component="cleanupStatusLabel"] {
    color: @text;
}

QTextEdit[h5Component="cleanupLogView"] {
    background-color: @hex_303030;
    color: @hex_d4d4d4;
    font-family: Consolas, "Courier New", monospace;
    font-size: 11px;
    border: 1px solid @hex_434343;
}
QLabel[h5Component="cleanupDirtlistLabel"] {
    color: @hex_a1a1a1;
    font-size: 11px;
    background-color: transparent;
}
QLabel[h5Component="cleanupTransparentLabel"] {
    color: @text;
    background-color: transparent;
}

/* forms/source_porter/main.py: SourcePorterWidget dialog + asset-import
   sub-dialog. Reproduces what used to be one big local QDialog stylesheet
   (mostly identical to the app defaults already in qss/*.qss) so the
   distinctive per-button color variants (btn_port/btn_find_missing/btn_stop)
   keep working, without leaving the dialog to fall out of sync with a live
   theme switch. */
QLabel[h5Component="sourcePorterInstructionLabel"] {
    color: @text_muted;
    font: 580 9pt "Segoe UI";
}
QPlainTextEdit[h5Component="sourcePorterPathsEditor"] {
    background-color: @surface;
    color: @text;
    border: 1px solid @border;
    border-radius: 4px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9.5pt;
    padding: 6px;
}


/* forms/unreal_porter/asset_selection.py: asset-picker dialog. */
QDialog[h5Component="unrealAssetSelectionDialog"] {
    background-color: @surface;
}
QLabel[h5Component="unrealAssetSelectionNote"] {
    color: @hex_8a8a8a;
}

/* forms/unreal_porter/main.py */
QWidget[h5Component="unrealPorterWindow"] {
    background-color: @surface;
}

/* forms/unreal_porter/master_material_list.py: zebra-striped material cards
   and the section divider. */
QFrame[h5Component="unrealMasterMaterialCard"][parity="true"] {
    background-color: @surface_raised;
}
QFrame[h5Component="unrealMasterMaterialCard"][parity="false"] {
    background-color: @background;
}
QLabel[h5Component="unrealMaterialCardLabel"] {
    background: transparent;
}
QFrame[h5Component="unrealSectionDividerLine"] {
    color: @border;
}
QLabel[h5Component="unrealSectionDividerLabel"] {
    color: @text_muted;
    font: 600 9pt "Segoe UI";
    background: transparent;
}

/* settings/main.py: Preferences dialog. */
QTabWidget[h5Component="settingsTabWidget"] {
    background-color: @background;
}
QFrame[h5Component="settingsDivider"] {
    background-color: @hex_424242;
    border: none;
}
QScrollArea[h5Component="settingsScrollArea"] {
    border: none;
}

QPushButton[h5Component="gitSyncButton"] {
    padding: 2px 4px;
}
QLabel[h5Component="gitConflictStatus"][h5State="conflict"] {
    color: @hex_e5a00d;
}
QLabel[h5Component="gitConflictStatus"][h5State="resolved"] {
    color: @hex_7fb800;
}
QFrame[h5Component="gitConflictRow"] {
    background: @surface_raised;
    border: @border_width solid @border;
    border-radius: @radius;
}
QLabel[h5Component="gitLeftoverNote"] {
    color: @warning;
}
QLabel[h5Component="gitHint"],
QLabel[h5Component="gitSetupPath"] {
    color: @text_muted;
}

QLabel[h5Component="unrealMaterialThumbnail"] {
    border: 1px solid @hex_3a3a3c;
    border-radius: 3px;
    background-color: @hex_111111;
}
QLabel[h5State="available"] { color: @hex_7ac07a; }
QLabel[h5State="missing"] { color: @hex_d08a4a; }
QLabel[h5Component="unrealTextureThumbnail"] {
    border: 1px solid @hex_383838;
    background-color: @hex_1a1a1c;
    border-radius: 4px;
    color: @hex_999999;
    font-size: 9px;
    font-weight: bold;
}
QComboBox[h5Component="unrealChannelCombo"]:disabled {
    color: @text_disabled;
    background-color: @surface;
}
QPushButton[h5Component="unrealColorSwatch"] {
    border: 1px solid @border_strong;
    border-radius: 3px;
}
QPushButton[h5Component="unrealColorSwatch"]:hover {
    border-color: @text_muted;
}

/* updater/attachment_preview.py: changelog attachment cards (image/video/file). */
QFrame#AttachmentThumbnailCard {
    background: transparent;
    border: none;
    padding: 4px 0px;
    margin: 0px;
}
QFrame#AttachmentThumbnailCard QLabel {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
    qproperty-alignment: AlignCenter;
}
QLabel[h5Component="attachmentPreviewLoading"] {
    color: @hex_929292;
    font-size: 11px;
    background: transparent;
    border: none;
}
QLabel[h5Component="attachmentPreviewError"] {
    color: @hex_797979;
    font-size: 10px;
    font-style: italic;
}
QMenu[h5Component="attachmentContextMenu"] {
    background-color: @background;
    color: @text;
    border: 1px solid @border;
    padding: 4px;
}
QMenu[h5Component="attachmentContextMenu"]::item:selected {
    background-color: @selection;
}
QFrame#VideoAttachmentCard, QFrame#FileAttachmentCard {
    background: transparent;
    border: none;
    padding: 2px 5px;
    margin: 0px;
}
QFrame#VideoAttachmentCard QPushButton, QFrame#FileAttachmentCard QPushButton {
    background-color: @hex_373737;
    color: @text;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 3px 10px;
    font-size: 11px;
}
QFrame#VideoAttachmentCard QPushButton:hover, QFrame#FileAttachmentCard QPushButton:hover {
    background-color: @accent;
    color: @selection_text;
}
QLabel[h5Component="attachmentVideoIcon"] {
    color: @accent;
    font-size: 14px;
    font-weight: bold;
}
QLabel[h5Component="attachmentCardTitle"] {
    color: @text;
    font-size: 11px;
    font-weight: bold;
}
QLabel[h5Component="attachmentCardSubtitle"] {
    color: @text_muted;
    font-size: 10px;
}
QLabel[h5Component="attachmentFileIcon"] {
    font-size: 14px;
}

/* updater/check.py: update dialog. */
QLabel[h5Component="updaterStatusLabel"] {
    color: @text;
    font-size: 12px;
    font-weight: bold;
}
QLabel[h5Component="updaterVersionLabel"] {
    padding: 5px 5px 0px 5px;
}
QLabel[h5Component="updaterNoteLabel"] {
    padding: 0px 5px;
}

/* app_core.py / updater/check.py: amber "Update" call to action. */
QPushButton[h5Component="updateButton"] {
    background-color: @warning;
    border: 1px solid @warning;
    color: @hex_1e1e1e;
    font: 580 10pt "Segoe UI";
    padding: 5px 12px;
}
QPushButton[h5Component="updateButton"]:hover {
    background-color: @hex_f0b02a;
    border-color: @hex_f0b02a;
}
QPushButton[h5Component="updateButton"]:pressed {
    background-color: @hex_c9880a;
    border-color: @hex_c9880a;
}

/* widgets/common.py: ErrorInfo dialog's details box. border-color varies
   (amber for warnings, red for errors) via a small local override. */
QTextEdit[h5Component="errorInfoDetails"] {
    background-color: @background;
}
QTextEdit[h5Component="errorInfoDetails"][h5State="warning"] {
    border-color: @hex_e5c07b;
}
QTextEdit[h5Component="errorInfoDetails"][h5State="error"] {
    border-color: @hex_974533;
}

/* forms/unreal_porter/slot_mapping.py: shader-remapper dialog headers
   (feature-group / texture-slots / parameter-overrides sections). */
QLabel[h5Component="unrealShaderFeatureHeader"] {
    background-color: @hex_3e3e41;
    color: @hex_e2e2e2;
    padding: 3px;
    font-size: 11px;
    font-weight: bold;
    border-radius: 2px;
}
QLabel[h5Component="unrealShaderSectionHeader"] {
    background-color: @hex_3e3e41;
    color: @hex_e2e2e2;
    padding: 4px;
    font-size: 11px;
    font-weight: bold;
    border-radius: 2px;
}

/* forms/about/main.py: About / documentation dialog. */
QDialog[h5Component="aboutDialog"] {
    background-color: @surface;
    color: @text;
}
QFrame[h5Component="aboutHeaderFrame"] {
    background: transparent;
    border: none;
}
QLabel[h5Component="aboutLogoLabel"] {
    background: transparent;
    border: none;
}
QLabel[h5Component="aboutVersionLabel"] {
    color: @text_muted;
    background: transparent;
    border: none;
}
QFrame[h5Component="aboutContentFrame"] {
    background-color: @surface_raised;
    border: 1px solid @border;
    border-radius: 0px;
}
QFrame[h5Component="aboutVideoCard"] {
    background-color: @surface_input;
    border: 1px solid @border;
    border-radius: 0px;
}
QLabel[h5Component="aboutYtPreview"] {
    border: 1px solid @border;
    border-radius: 0px;
    background-color: @hex_000000;
}
QLabel[h5Component="aboutVideoTitle"] {
    color: @accent;
    border: none;
    background: transparent;
}
QLabel[h5Component="aboutVideoDesc"] {
    color: @text_muted;
    border: none;
    background: transparent;
}
QPushButton[h5Component="aboutWatchVideoButton"] {
    font: 600 9.5pt "Segoe UI";
    border: 1px solid @hex_e05252;
    border-radius: 0px;
    padding: 6px 14px;
    color: @hex_ffffff;
    background-color: @hex_c0392b;
}
QPushButton[h5Component="aboutWatchVideoButton"]:hover {
    background-color: @hex_e74c3c;
    border-color: @hex_ff6b6b;
}
QPushButton[h5Component="aboutWatchVideoButton"]:pressed {
    background-color: @hex_962d22;
}
QFrame[h5Component="aboutGuidesCard"] {
    background-color: @surface_input;
    border: 1px solid @border;
    border-radius: 0px;
}
QLabel[h5Component="aboutGuidesHeader"] {
    color: @warning;
    border: none;
    background: transparent;
}
QPushButton[h5Component="aboutGuideButton"] {
    font: 580 9pt "Segoe UI";
    border: 1px solid @border;
    border-radius: 0px;
    padding: 6px 12px;
    color: @text;
    background-color: @surface_raised;
}
QPushButton[h5Component="aboutGuideButton"]:hover {
    background-color: @selection;
    color: @selection_text;
    border-color: @accent;
}
QPushButton[h5Component="aboutGuideButton"]:pressed {
    background-color: @accent_pressed;
    color: @selection_text;
}
QFrame[h5Component="aboutSupportCard"] {
    background-color: @surface_input;
    border: 1px solid @border;
    border-radius: 0px;
}
QLabel[h5Component="aboutSupportIcon"] {
    background: transparent;
    border: none;
    padding: 0px;
}
QLabel[h5Component="aboutSupportHeader"] {
    color: @text;
    border: none;
    background: transparent;
}
QLabel[h5Component="aboutSupportDesc"] {
    color: @text_muted;
    border: none;
    background: transparent;
}
QPushButton[h5Component="aboutSupportButton"] {
    font: 580 9pt "Segoe UI";
    border: 1px solid @border;
    border-radius: 0px;
    padding: 6px 14px;
    color: @text;
    background-color: @surface_raised;
}
QPushButton[h5Component="aboutSupportButton"]:hover {
    background-color: @selection;
    color: @selection_text;
    border-color: @accent;
}
QPushButton[h5Component="aboutSupportButton"]:pressed {
    background-color: @accent_pressed;
    color: @selection_text;
}
QLabel[h5Component="aboutSpecialThanks"] {
    color: @text_muted;
    border: none;
    background: transparent;
    padding: 2px;
}
QFrame[h5Component="aboutBottomBar"] {
    background: transparent;
    border: none;
}
QPushButton[h5Component="aboutDontShowButton"] {
    font: 500 8.5pt "Segoe UI";
    border: 1px solid @border;
    border-radius: 0px;
    padding: 4px 8px;
    color: @text_muted;
    background-color: @surface;
}
QPushButton[h5Component="aboutDontShowButton"]:hover {
    background-color: @selection;
    color: @selection_text;
    border-color: @border_strong;
}
QPushButton[h5Component="aboutDontShowButton"]:checked {
    background-color: @error;
    color: @selection_text;
}
QPushButton[h5Component="aboutActionButton"] {
    font: 580 9pt "Segoe UI";
    border: 1px solid @border;
    border-radius: 0px;
    padding: 4px 14px;
    color: @text;
    background-color: @surface;
}
QPushButton[h5Component="aboutActionButton"]:hover {
    background-color: @selection;
    color: @selection_text;
}
QPushButton[h5Component="aboutActionButton"]:pressed {
    background-color: @accent_pressed;
    color: @selection_text;
}
