/* QMenu / QMenuBar. Split out of qt_global_stylesheet.py during the
   styling-refactor migration. Behavior preserved as-is. */

QMenu {
    background-color: @surface_raised;
    color: @hex_d0d0d0;
    border: 1px solid @hex_636363;
    border: 2px solid black;
    border-radius: 1px;
    border-color: @rgba_5e5e5e_255;
}

QMenu::item {
    font: 600 10pt "Segoe UI";
    border: 1px solid transparent;
    border-radius: 1px;
    border-top: 0px;
    border-bottom: 2px solid transparent;
    border-color: @rgba_5e5e5e_105;
    padding: 4px 8px 4px 8px;
    padding-right: 20px;
    color: @hex_d0d0d0;
}

QMenu::item:selected {
    background-color: @selection;
    color: @selection_text;
    border: 1px solid transparent;
    border-radius: 1px;
    border-top: 0px;
    border-bottom: 2px solid transparent;
    border-color: @rgba_5e5e5e_105;
}

QMenu::item:disabled {
    color: @hex_636363;
    background-color: transparent;
}

QMenu::item:selected:disabled {
    color: @hex_636363;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background: @hex_6e727a;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

QMenu::indicator:checked {
    image: url(:/icons/check_16dp.svg);
}

QMenu::indicator:unchecked {
    image: url(:/icons/check_box_outline_blank_16dp.svg);
}

QMenuBar {
    background-color: transparent;
    color: @text;
    font: 580 10pt "Segoe UI";
    border: none;
    padding: 0px 2px;
}

QMenuBar::item {
    background-color: transparent;
    color: @text;
    padding: 4px 8px;
    border-radius: 2px;
}

QMenuBar::item:selected {
    background-color: @selection;
    color: @selection_text;
}

QMenuBar::item:pressed {
    background-color: @accent_pressed;
    color: @selection_text;
}

QMenuBar::item:disabled {
    color: @text_disabled;
    background-color: transparent;
}
