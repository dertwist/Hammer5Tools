<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SourcePorter.Core</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SourcePorter.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- VPK and KeyValues readers used by asset validation and VMAP tooling. -->
    <PackageReference Include="ValvePak" Version="5.0.2.177" />
    <PackageReference Include="ValveKeyValue" Version="0.70.0.499" />

    <!-- Datamodel (DMX) reader/writer for the uncompiled VMAP graph. -->
    <PackageReference Include="KeyValues2" Version="0.8.0" />

  </ItemGroup>

</Project>
