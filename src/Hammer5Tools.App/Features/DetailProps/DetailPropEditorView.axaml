<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.DetailProps"
             xmlns:m="using:Hammer5Tools.Core.DetailProps"
             x:Class="Hammer5Tools.App.Features.DetailProps.DetailPropEditorView"
             x:DataType="vm:DetailPropEditorViewModel">
  <Grid ColumnDefinitions="250,250,*" Margin="12">
    <!-- Column 0: Prop Types list -->
    <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="6" Padding="8" Margin="0,0,8,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Detail Types" FontWeight="Bold" Margin="4,0,0,8" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:DetailPropType">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,8,0,0">
          <Button Grid.Column="0" Content="Add Type" Command="{Binding AddTypeCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
          <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteTypeCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
        </Grid>
      </Grid>
    </Border>

    <!-- Column 1: Models list of selected type -->
    <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="6" Padding="8" Margin="0,0,8,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Models in Type" FontWeight="Bold" Margin="4,0,0,8" />
        <ListBox Grid.Row="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:DetailPropModel">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,8,0,0">
          <Button Grid.Column="0" Content="Add Model" Command="{Binding AddModelCommand}" HorizontalAlignment="Stretch" Margin="0,0,4,0" />
          <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteModelCommand}" HorizontalAlignment="Stretch" Margin="4,0,0,0" />
        </Grid>
      </Grid>
    </Border>

    <!-- Column 2: Property Inspector -->
    <Border Grid.Column="2" Background="#1E1E1E" CornerRadius="6" Padding="16">
      <ScrollViewer>
        <StackPanel Spacing="12">
          <TextBlock Text="Property Inspector" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

          <!-- Type Properties -->
          <TextBlock Text="Type Settings" FontWeight="SemiBold" Foreground="#00E5FF" />
          <Grid ColumnDefinitions="140,*">
            <TextBlock Grid.Column="0" Text="Type Name:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SelectedType.Name, FallbackValue=''}" />
          </Grid>
          <Grid ColumnDefinitions="140,*">
            <TextBlock Grid.Column="0" Text="Type Density:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedType.Density, FallbackValue=1.0}" Minimum="0.01" Maximum="100.0" Increment="0.1" />
          </Grid>

          <Separator Margin="0,8" />

          <!-- Model Properties -->
          <TextBlock Text="Model Settings" FontWeight="SemiBold" Foreground="#00E5FF" />
          <Grid ColumnDefinitions="140,*">
            <TextBlock Grid.Column="0" Text="Model Path:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SelectedModel.ModelName, FallbackValue=''}" />
          </Grid>
          <Grid ColumnDefinitions="140,*">
            <TextBlock Grid.Column="0" Text="Min Scale:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedModel.MinScale, FallbackValue=1.0}" Minimum="0.01" Maximum="10.0" Increment="0.05" />
          </Grid>
          <Grid ColumnDefinitions="140,*">
            <TextBlock Grid.Column="0" Text="Max Scale:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedModel.MaxScale, FallbackValue=1.0}" Minimum="0.01" Maximum="10.0" Increment="0.05" />
          </Grid>
          <Grid ColumnDefinitions="140,*">
            <TextBlock Grid.Column="0" Text="Model Density:" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedModel.Density, FallbackValue=1.0}" Minimum="0.01" Maximum="10.0" Increment="0.1" />
          </Grid>

          <!-- Booleans -->
          <CheckBox Content="Random Yaw" IsChecked="{Binding SelectedModel.RandomYaw, FallbackValue=true}" />
          <CheckBox Content="Random Pitch" IsChecked="{Binding SelectedModel.RandomPitch, FallbackValue=false}" />
          <CheckBox Content="Random Roll" IsChecked="{Binding SelectedModel.RandomRoll, FallbackValue=false}" />
          <CheckBox Content="Align to Surface" IsChecked="{Binding SelectedModel.AlignToSurface, FallbackValue=false}" />
          <CheckBox Content="Keep Upright" IsChecked="{Binding SelectedModel.Upright, FallbackValue=true}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
