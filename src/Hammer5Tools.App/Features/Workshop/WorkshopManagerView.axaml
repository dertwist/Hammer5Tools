<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.Workshop"
             x:Class="Hammer5Tools.App.Features.Workshop.WorkshopManagerView"
             x:DataType="vm:WorkshopManagerViewModel">
  <Grid ColumnDefinitions="360,*" Margin="8">
    <!-- Left Column: Workshop Metadata & Options -->
    <Border Grid.Column="0" Background="{DynamicResource H5TBackgroundBrush}" CornerRadius="2" Padding="8" Margin="0,0,8,0">
      <StackPanel Spacing="12">
        <TextBlock Text="Workshop Packaging" FontSize="14.667" FontWeight="Bold" Margin="0,0,0,8" />

        <Grid ColumnDefinitions="100,*">
          <TextBlock Grid.Column="0" Text="Title:" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding WorkshopTitle}" />
        </Grid>

        <Grid ColumnDefinitions="100,*">
          <TextBlock Grid.Column="0" Text="Description:" VerticalAlignment="Top" Margin="0,6,0,0" />
          <TextBox Grid.Column="1" Text="{Binding Description}" AcceptsReturn="True" Height="80" PlaceholderText="Workshop item summary..." />
        </Grid>

        <CheckBox Content="Exclude unused content" IsChecked="{Binding ExcludeUnused}" />

        <Button Content="Scan Addon Files" Command="{Binding RefreshFilesCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
        <Button Content="Build Workshop Package (.vpk)" Command="{Binding BuildPackageCommand}" HorizontalAlignment="Stretch" Background="{DynamicResource H5TSuccessDarkBrush}" FontWeight="Bold" />

        <Border Background="{DynamicResource H5TBackgroundBrush}" CornerRadius="4" Padding="8" Margin="0,12,0,0">
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource H5TSuccessBrush}" FontSize="11" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <!-- Right Column: Package Manifest / File Explorer -->
    <Border Grid.Column="1" Background="{DynamicResource H5TBackgroundBrush}" CornerRadius="2" Padding="12">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Packaged Files Manifest" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

        <ListBox Grid.Row="1" ItemsSource="{Binding PackageFiles}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" FontFamily="Consolas, Menlo, Monospace" FontSize="11" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
