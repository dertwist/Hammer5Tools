<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.NavMesh"
             x:Class="Hammer5Tools.App.Features.NavMesh.NavMeshRadarView"
             x:DataType="vm:NavMeshRadarViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16" MaxWidth="600" HorizontalAlignment="Left">
    <TextBlock Grid.Row="0" Text="NavMesh Radar Generator" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

    <StackPanel Grid.Row="1" Spacing="12">
      <Grid ColumnDefinitions="140,*">
        <TextBlock Grid.Column="0" Text="Map Name:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding MapName}" PlaceholderText="e.g. de_overpass" />
      </Grid>

      <Grid ColumnDefinitions="140,*">
        <TextBlock Grid.Column="0" Text="Resolution:" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Value="{Binding Resolution}" Minimum="512" Maximum="4096" Increment="512" />
      </Grid>

      <Grid ColumnDefinitions="140,*">
        <TextBlock Grid.Column="0" Text="Min Height (Z):" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Value="{Binding HeightMin}" Minimum="-10000" Maximum="10000" Increment="50" />
      </Grid>

      <Grid ColumnDefinitions="140,*">
        <TextBlock Grid.Column="0" Text="Max Height (Z):" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Value="{Binding HeightMax}" Minimum="-10000" Maximum="10000" Increment="50" />
      </Grid>

      <CheckBox Content="Collapse Faces into N-gons" IsChecked="{Binding CollapseNgons}" />

      <Button Content="Generate Radar (.png &amp; .vdata)" Command="{Binding GenerateRadarCommand}" Background="#1976D2" HorizontalAlignment="Left" Margin="0,8,0,0" />
    </StackPanel>

    <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="4" Padding="12" Margin="0,16,0,0">
      <TextBlock Text="{Binding Status}" Foreground="#80CBC4" />
    </Border>
  </Grid>
</UserControl>
