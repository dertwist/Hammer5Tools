<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.MapBuilder"
             xmlns:m="using:Hammer5Tools.Core.MapBuilder"
             x:Class="Hammer5Tools.App.Features.MapBuilder.MapBuilderView"
             x:DataType="vm:MapBuilderViewModel">
  <Grid ColumnDefinitions="340,3,*" Margin="8">
    <!-- Left Column: Build Configuration & Queue -->
    <Border Grid.Column="0" Background="{DynamicResource H5TConsoleBgBrush}" CornerRadius="2" Padding="12" Margin="0,0,8,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Compile Map" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,12">
          <Grid ColumnDefinitions="100,*">
            <TextBlock Grid.Column="0" Text="Map Name:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding MapName}" PlaceholderText="Map name (without .vmap)" />
          </Grid>

          <Grid ColumnDefinitions="100,*">
            <TextBlock Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" HorizontalAlignment="Stretch">
            </ComboBox>
          </Grid>

          <CheckBox Content="Clear VRAD3 Cache Before Build" IsChecked="{Binding ClearVrad}" />
          <CheckBox Content="Launch CS2 &amp; Load Map After Build" IsChecked="{Binding LaunchAfterBuild}" />

          <Button Content="Start Map Compile" Command="{Binding StartBuildCommand}" HorizontalAlignment="Stretch" Background="{DynamicResource H5TSuccessDarkBrush}" FontWeight="Bold" />
        </StackPanel>

        <!-- Build Queue / History -->
        <TextBlock Grid.Row="2" Text="Build History" FontWeight="SemiBold" Margin="0,4,0,4" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Margin="0,24,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:MapBuildJob">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding MapName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StartedAt, StringFormat='Started: {0:HH:mm:ss}'}" FontSize="11" Foreground="{DynamicResource H5TTextMutedBrush}" />
                </StackPanel>
                <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" />
    <Border Grid.Column="2" Background="{DynamicResource H5TSurfaceInputBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource H5TAccentBrush}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="3" Content="Cancel Build" Command="{Binding CancelBuildCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Background="{DynamicResource H5TErrorDarkBrush}" />
      </Grid>
    </Border>

    <!-- Right Column: Compile Logs Viewer -->
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" />
    <Border Grid.Column="2" Background="{DynamicResource H5TConsoleBgBrush}" CornerRadius="2" Padding="12">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Text="Compilation Logs" FontWeight="Bold" FontSize="14" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedJob.Status, FallbackValue='No Job Selected', StringFormat='Status: {0}'}" Foreground="{DynamicResource H5TSuccessBrush}" FontWeight="SemiBold" />
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedJob.OutputLogs}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" FontFamily="Consolas, Menlo, Monospace" FontSize="11" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
