<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.MapBuilder"
             xmlns:m="using:Hammer5Tools.Core.MapBuilder"
             x:Class="Hammer5Tools.App.Features.MapBuilder.MapBuilderView"
             x:DataType="vm:MapBuilderViewModel">
  <Grid ColumnDefinitions="340,*" Margin="12">
    <!-- Left Column: Build Configuration & Queue -->
    <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="6" Padding="12" Margin="0,0,8,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Compile Map" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,12">
          <Grid ColumnDefinitions="100,*">
            <TextBlock Grid.Column="0" Text="Map Name:" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding MapName}" PlaceholderText="Map name (without .vmap)" />
          </Grid>

          <Grid ColumnDefinitions="100,*">
            <TextBlock Grid.Column="0" Text="Preset:" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" SelectedIndex="1" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Fast (fast VRAD, no compress)" />
              <ComboBoxItem Content="Standard (default VRAD)" />
              <ComboBoxItem Content="Final (full VRAD with compression)" />
            </ComboBox>
          </Grid>

          <CheckBox Content="Clear VRAD3 Cache Before Build" IsChecked="{Binding ClearVrad}" />
          <CheckBox Content="Launch CS2 &amp; Load Map After Build" IsChecked="{Binding LaunchAfterBuild}" />

          <Button Content="Start Map Compile" Command="{Binding StartBuildCommand}" HorizontalAlignment="Stretch" Background="#2E7D32" FontWeight="Bold" />
        </StackPanel>

        <!-- Build Queue / History -->
        <TextBlock Grid.Row="2" Text="Build History" FontWeight="SemiBold" Margin="0,4,0,4" />
        <ListBox Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Margin="0,24,0,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:MapBuildJob">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding MapName}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StartedAt, StringFormat='Started: {0:HH:mm:ss}'}" FontSize="11" Foreground="#9E9E9E" />
                </StackPanel>
                <Border Grid.Column="1" Background="#2A2A2A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#00E5FF" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="3" Content="Cancel Build" Command="{Binding CancelBuildCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Background="#C62828" />
      </Grid>
    </Border>

    <!-- Right Column: Compile Logs Viewer -->
    <Border Grid.Column="1" Background="#141414" CornerRadius="6" Padding="12">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Text="Compilation Logs" FontWeight="Bold" FontSize="14" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedJob.Status, FallbackValue='No Job Selected', StringFormat='Status: {0}'}" Foreground="#80CBC4" FontWeight="SemiBold" />
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding SelectedJob.OutputLogs}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" FontFamily="Consolas, Menlo, Monospace" FontSize="11" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
