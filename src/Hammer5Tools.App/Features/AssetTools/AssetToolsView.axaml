<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.AssetTools"
             x:Class="Hammer5Tools.App.Features.AssetTools.AssetToolsView"
             x:DataType="vm:AssetToolsViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16" MaxWidth="640" HorizontalAlignment="Left">
    <TextBlock Grid.Row="0" Text="Asset Rename &amp; Reference Rewriter" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

    <StackPanel Grid.Row="1" Spacing="12">
      <TextBlock Text="Safely move or rename textures, materials, or models across the addon. All references in .vmap, .vmat, and .vmdl files will automatically be updated." TextWrapping="Wrap" Foreground="#9E9E9E" />

      <Grid ColumnDefinitions="140,*">
        <TextBlock Grid.Column="0" Text="Current Path:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding OldPath}" PlaceholderText="materials/models/props/crate.vmat" />
      </Grid>

      <Grid ColumnDefinitions="140,*">
        <TextBlock Grid.Column="0" Text="New Path:" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding NewPath}" PlaceholderText="materials/custom/crate.vmat" />
      </Grid>

      <Button Content="Move &amp; Rewrite References" Command="{Binding MoveAssetCommand}" Background="#1976D2" HorizontalAlignment="Left" Margin="0,8,0,0" />
    </StackPanel>

    <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="4" Padding="12" Margin="0,16,0,0">
      <TextBlock Text="{Binding Status}" Foreground="#80CBC4" />
    </Border>
  </Grid>
</UserControl>
