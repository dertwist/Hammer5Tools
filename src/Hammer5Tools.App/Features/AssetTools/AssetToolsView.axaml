<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:explorer="using:Hammer5Tools.App.Features.Explorer"
             xmlns:vm="using:Hammer5Tools.App.Features.AssetTools"
             x:Class="Hammer5Tools.App.Features.AssetTools.AssetToolsView"
             x:DataType="vm:AssetToolsViewModel">
  <Grid ColumnDefinitions="300,5,*" Margin="8">
    <explorer:AssetExplorerView DataContext="{Binding Explorer}" />
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" Margin="8,0,0,0">
      <TextBox Text="{Binding OldPath}" PlaceholderText="Select the source asset in the explorer" />
      <TextBox Grid.Row="1" Text="{Binding NewPath}" PlaceholderText="Destination path relative to the addon" Margin="0,6" />
      <Border Grid.Row="2" Background="{DynamicResource H5TBackgroundBrush}" Padding="8">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </Border>
      <Button Grid.Row="3" Content="Apply move and rewrite references" Command="{Binding MoveAssetCommand}" HorizontalAlignment="Right" Margin="0,6,0,0" />
    </Grid>
  </Grid>
</UserControl>
