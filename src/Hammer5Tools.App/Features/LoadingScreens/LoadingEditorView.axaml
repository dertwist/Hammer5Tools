<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hammer5Tools.App.Features.LoadingScreens" xmlns:m="using:Hammer5Tools.Core.LoadingScreens"
             xmlns:workspace="using:Hammer5Tools.App.Controls"
             x:Class="Hammer5Tools.App.Features.LoadingScreens.LoadingEditorView" x:DataType="vm:LoadingEditorViewModel">
  <workspace:WorkspaceView LayoutKey="LoadingScreens" LeftTitle="Screenshots" RightTitle="Map icon" RightBottomTitle="Description">
    <workspace:WorkspaceView.LeftContent>
      <Grid RowDefinitions="*,Auto,Auto,Auto" Margin="8">
        <TabControl>
          <TabItem Header="Explorer">
            <Grid RowDefinitions="Auto,*">
              <Button Content="Refresh" Command="{Binding RefreshScreenshotsCommand}" HorizontalAlignment="Left" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Screenshots}" SelectedItem="{Binding SelectedImagePath}" />
            </Grid>
          </TabItem>
          <TabItem Header="Timeline">
            <Grid RowDefinitions="Auto,*">
              <Button Content="Refresh cameras" Command="{Binding RefreshCamerasCommand}" HorizontalAlignment="Left" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}">
                <ListBox.ItemTemplate><DataTemplate x:DataType="m:CameraInfo"><TextBlock Text="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
        <Button Grid.Row="1" Content="Take loading screen shot" Command="{Binding CaptureScreenshotCommand}" Margin="0,6" />
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><TextBox Text="{Binding SelectedImagePath}" PlaceholderText="Screenshot path" /><Button Grid.Column="1" Content="Browse" Command="{Binding BrowseImageCommand}" /></Grid>
        <Button Grid.Row="3" Content="Apply screenshots" Command="{Binding GenerateLoadingScreenCommand}" Margin="0,6" />
      </Grid>
    </workspace:WorkspaceView.LeftContent>
    <workspace:WorkspaceView.CenterContent>
      <Grid RowDefinitions="*,Auto" Margin="8">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image Source="{Binding ImagePreview}" Stretch="Uniform" /></ScrollViewer>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,4" TextWrapping="Wrap" />
      </Grid>
    </workspace:WorkspaceView.CenterContent>
    <workspace:WorkspaceView.RightContent>
      <StackPanel Spacing="6" Margin="8">
        <TextBlock Text="Map icon" Classes="section" />
        <TextBox Text="{Binding MapIconPath}" PlaceholderText="SVG path" />
        <Button Content="Browse SVG" Command="{Binding BrowseIconCommand}" />
        <Button Content="Apply icon" Command="{Binding ApplyIconCommand}" />
      </StackPanel>
    </workspace:WorkspaceView.RightContent>
    <workspace:WorkspaceView.RightBottomContent>
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">
        <TextBox Text="{Binding MapTitle}" PlaceholderText="Map title" />
        <TextBox Grid.Row="1" Text="{Binding Author}" PlaceholderText="Author" Margin="0,6" />
        <TextBox Grid.Row="2" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Map description and credits" />
        <Button Grid.Row="3" Content="Apply description" Command="{Binding SaveCommand}" Margin="0,6" />
      </Grid>
    </workspace:WorkspaceView.RightBottomContent>
  </workspace:WorkspaceView>
</UserControl>
