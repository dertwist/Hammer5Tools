<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Semantic Theme Palette from STYLESHEET.md and theme.py -->
  <Styles.Resources>
    <SolidColorBrush x:Key="H5TBackgroundBrush" Color="#2e2e2e" />
    <SolidColorBrush x:Key="H5TSurfaceBrush" Color="#272727" />
    <SolidColorBrush x:Key="H5TSurfaceRaisedBrush" Color="#2f2f31" />
    <SolidColorBrush x:Key="H5TSurfaceInputBrush" Color="#363637" />
    <SolidColorBrush x:Key="H5TTextBrush" Color="#e5e5e5" />
    <SolidColorBrush x:Key="H5TTextMutedBrush" Color="#a5a5a5" />
    <SolidColorBrush x:Key="H5TTextDisabledBrush" Color="#797979" />
    <SolidColorBrush x:Key="H5TBorderBrush" Color="#464649" />
    <SolidColorBrush x:Key="H5TBorderStrongBrush" Color="#5e5e5e" />
    <SolidColorBrush x:Key="H5TAccentBrush" Color="#4a83c9" />
    <SolidColorBrush x:Key="H5TAccentHoverBrush" Color="#586776" />
    <SolidColorBrush x:Key="H5TAccentPressedBrush" Color="#6d7882" />
    <SolidColorBrush x:Key="H5TSelectionBrush" Color="#515965" />
    <SolidColorBrush x:Key="H5TSelectionTextBrush" Color="#ffffff" />
    <SolidColorBrush x:Key="H5TErrorBrush" Color="#d1494a" />
    <SolidColorBrush x:Key="H5TWarningBrush" Color="#e5a00d" />
    <SolidColorBrush x:Key="H5TSuccessBrush" Color="#5ab55e" />
  </Styles.Resources>

  <!-- Window Default Styling -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, sans-serif" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Button Styling -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource H5TAccentHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TBorderStrongBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource H5TAccentPressedBrush}" />
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#292929" />
    <Setter Property="BorderBrush" Value="#3f3f42" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Foreground" Value="{StaticResource H5TTextDisabledBrush}" />
  </Style>

  <!-- Specific Button Variants -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource H5TAccentBrush}" />
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="#356fb0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#5c95dd" />
  </Style>

  <Style Selector="Button.success">
    <Setter Property="Background" Value="#2e7d32" />
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="#1b5e20" />
  </Style>
  <Style Selector="Button.success:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#388e3c" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#c62828" />
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="#b71c1c" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#d32f2f" />
  </Style>

  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceInputBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TBorderBrush}" />
  </Style>

  <!-- TextBox Styling -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceInputBrush}" />
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="SelectionBrush" Value="{StaticResource H5TSelectionBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border">
    <Setter Property="BorderBrush" Value="{StaticResource H5TAccentBrush}" />
  </Style>

  <!-- ComboBox Styling -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceInputBrush}" />
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- ListBox Styling -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource H5TSelectionBrush}" />
    <Setter Property="Foreground" Value="{StaticResource H5TSelectionTextBrush}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceInputBrush}" />
  </Style>

  <!-- Menu & Menu Items -->
  <Style Selector="Menu">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceBrush}" />
    <Setter Property="Height" Value="28" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border">
    <Setter Property="Background" Value="{StaticResource H5TSelectionBrush}" />
  </Style>

  <!-- ContextMenu -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- TabControl & TabItem -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="{StaticResource H5TBackgroundBrush}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{StaticResource H5TTextMutedBrush}" />
    <Setter Property="Background" Value="{StaticResource H5TSurfaceBrush}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TabItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="Background" Value="{StaticResource H5TSurfaceRaisedBrush}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="Background" Value="{StaticResource H5TSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TAccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>

  <!-- ToolTip -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{StaticResource H5TBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource H5TTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource H5TBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ScrollBar -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="{StaticResource H5TSurfaceBrush}" />
  </Style>

  <!-- Separator -->
  <Style Selector="Separator">
    <Setter Property="Background" Value="{StaticResource H5TBorderBrush}" />
    <Setter Property="Height" Value="1" />
  </Style>

  <!-- TextBlock Typography Helpers -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource H5TTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource H5TAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{StaticResource H5TSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{StaticResource H5TErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{StaticResource H5TWarningBrush}" />
  </Style>

</Styles>
