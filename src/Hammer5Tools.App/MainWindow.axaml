<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Hammer5Tools.App.Features.Shell"
        xmlns:vm="using:Hammer5Tools.App.ViewModels"
        xmlns:addons="using:Hammer5Tools.Core.Addons"
        xmlns:explorer="using:Hammer5Tools.App.Features.Explorer"
        xmlns:workspace="using:Hammer5Tools.App.Controls"
        xmlns:conv="using:Hammer5Tools.App.Converters"
        x:Class="Hammer5Tools.App.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="Hammer 5 Tools"
        Icon="avares://Hammer5Tools.App/Assets/Icons/hammer_icon.png"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Top Menu Bar -->
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_Open" Command="{Binding OpenFileCommand}" HotKey="Ctrl+O" />
        <MenuItem Header="_Save Current" Command="{Binding SaveDocumentCommand}" HotKey="Ctrl+S" InputGesture="Ctrl+S" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Undo" Command="{Binding UndoDocumentCommand}" HotKey="Ctrl+Z" />
        <MenuItem Header="Redo" Command="{Binding RedoDocumentCommand}" HotKey="Ctrl+Shift+Z" />
        <MenuItem Header="Preferences" Command="{Binding OpenPreferencesCommand}" />
      </MenuItem>
      <MenuItem Header="_View"><MenuItem Header="Reset dock layouts" Command="{Binding ResetLayoutCommand}" /></MenuItem>
      <MenuItem Header="_Addon">
        <MenuItem Header="Refresh Addon List" Command="{Binding RefreshAddonsCommand}" />
        <MenuItem Header="Open Content Folder" Command="{Binding OpenContentFolderCommand}" />
        <MenuItem Header="Open Game Folder" Command="{Binding OpenGameFolderCommand}" />
      </MenuItem>
      <MenuItem Header="_CS2">
        <MenuItem Header="Launch Workshop Tools" Command="{Binding LaunchCs2Command}" />
        <MenuItem Header="Restart Workshop Tools" Command="{Binding RestartCs2Command}" />
        <MenuItem Header="Kill Workshop Tools" Command="{Binding KillCs2Command}" />
        <Separator />
        <MenuItem Header="Clear VRAD3 Cache" Command="{Binding ClearVrad3CacheCommand}" />
      </MenuItem>
      <MenuItem Header="_Editors">
        <MenuItem Header="Loading Screen Editor" Command="{Binding OpenLoadingEditorCommand}" />
        <MenuItem Header="SoundEvent Editor" Command="{Binding OpenSoundEventEditorCommand}" />
        <MenuItem Header="Hotkey Editor" Command="{Binding OpenHotkeyEditorCommand}" />
        <MenuItem Header="DetailProp Editor" Command="{Binding OpenDetailPropEditorCommand}" />
      </MenuItem>
      <MenuItem Header="_Utilities">
        <MenuItem Header="Map Builder" Command="{Binding OpenMapBuilderCommand}" />
        <MenuItem Header="Workshop Manager" Command="{Binding OpenWorkshopManagerCommand}" />
        <MenuItem Header="Asset Tools (Rename / Relink)" Command="{Binding OpenAssetToolsCommand}" />
        <MenuItem Header="NavMesh Radar" Command="{Binding OpenNavMeshRadarCommand}" />
        <Separator />
        <MenuItem Header="Git Sync (Prototype)" Command="{Binding OpenGitSyncCommand}" />
        <MenuItem Header="Console Log" Command="{Binding OpenConsoleCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Documentation" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/dertwist/Hammer5Tools" />
        <MenuItem Header="Discord Community" Command="{Binding OpenUrlCommand}" CommandParameter="https://discord.gg/hammer5tools" />
        <MenuItem Header="GitHub Repository" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/dertwist/Hammer5Tools" />
        <Separator />
        <MenuItem Header="_About Hammer 5 Tools" />
      </MenuItem>
    </Menu>

    <workspace:WorkspaceView Grid.Row="1" LayoutKey="Shell" LeftTitle="Asset Explorer">
      <workspace:WorkspaceView.LeftContent>
        <explorer:AssetExplorerView DataContext="{Binding Explorer}" />
      </workspace:WorkspaceView.LeftContent>
      <workspace:WorkspaceView.CenterContent>
      <TabControl
                  ItemsSource="{Binding Documents}"
                  SelectedItem="{Binding ActiveDocument}"
                  Background="{DynamicResource H5TSurfaceRaisedBrush}">
        <TabControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DocumentViewModel">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Image Source="{Binding IconUri, Converter={StaticResource UriToBitmapConverter}}"
                     Width="15"
                     Height="15"
                     VerticalAlignment="Center" />
              <TextBlock Text="{Binding DisplayTitle}"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         FontSize="12" />
              <Button Content="✕"
                      Classes="subtle"
                      Command="{Binding CloseCommand}"
                      FontSize="10"
                      Padding="2,0"
                      Margin="4,0,0,0"
                      VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </TabControl.ItemTemplate>
      </TabControl>
      </workspace:WorkspaceView.CenterContent>
    </workspace:WorkspaceView>

    <!-- Bottom Button Line with Console Line, Addon Selector, Actions, Utilities, Edit Map (Classic Hammer5Tools Layout) -->
    <Border Grid.Row="2" Background="{DynamicResource H5TSurfaceBrush}" BorderBrush="{DynamicResource H5TBorderBrush}" BorderThickness="0,1" Padding="8,4">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
        <!-- Left: Twitter, Discord, About, Git Sync buttons -->
        <Button Grid.Column="0"
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://twitter.com"
                ToolTip.Tip="Twitter / X profile"
                Classes="subtle"
                Padding="6,4"
                Margin="0,0,2,0">
          <Image Source="avares://Hammer5Tools.App/Assets/Icons/twitter.png" Width="16" Height="16" />
        </Button>
        <Button Grid.Column="1"
                Command="{Binding OpenUrlCommand}"
                CommandParameter="https://discord.gg/hammer5tools"
                ToolTip.Tip="Discord Community Server"
                Classes="subtle"
                Padding="6,4"
                Margin="0,0,2,0">
          <Image Source="avares://Hammer5Tools.App/Assets/Icons/discord.png" Width="16" Height="16" />
        </Button>
        <Button Grid.Column="2"
                Command="{Binding OpenPreferencesCommand}"
                ToolTip.Tip="Preferences"
                Margin="2,0,2,0">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="3"
                Command="{Binding OpenConsoleCommand}"
                ToolTip.Tip="Open Console &amp; activity log window"
                Margin="2,0,6,0">
          <TextBlock Text="Console" VerticalAlignment="Center" />
        </Button>

        <!-- Center: Wide Sunken Console Line showing status/logs, clickable to open console dialog -->
        <Border Grid.Column="4" Background="{DynamicResource H5TConsoleBgBrush}" BorderBrush="{DynamicResource H5TBorderSubtleBrush}" BorderThickness="1" CornerRadius="2" Margin="2,0" Padding="8,2" ToolTip.Tip="Console activity — click to open full console window">
          <Button Command="{Binding OpenConsoleCommand}" Classes="subtle" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Padding="0">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="▶ " Foreground="{DynamicResource H5TAccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource H5TTextMutedBrush}" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource H5TFontFamily}" />
            </Grid>
          </Button>
        </Border>

        <!-- Utilities Menu Button (Map Builder, Workshop Manager, Asset Tools, NavMesh Radar dialogs) -->
        <Button Grid.Column="5" Content="Utilities ▾" Margin="4,0" ToolTip.Tip="Open standalone utility tools">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="Map Builder" Command="{Binding OpenMapBuilderCommand}" />
              <MenuItem Header="Workshop Manager" Command="{Binding OpenWorkshopManagerCommand}" />
              <MenuItem Header="Asset Tools (Rename / Relink)" Command="{Binding OpenAssetToolsCommand}" />
              <MenuItem Header="NavMesh Radar" Command="{Binding OpenNavMeshRadarCommand}" />
              <Separator />
              <MenuItem Header="Git Sync (Prototype)" Command="{Binding OpenGitSyncCommand}" />
              <MenuItem Header="Console Log" Command="{Binding OpenConsoleCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Actions Menu Button (Folder navigation, refresh, cache, CS2 controls) -->
        <Button Grid.Column="6" Content="Actions ▾" Margin="4,0" ToolTip.Tip="Addon actions and tool settings">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="Open Content Folder" Command="{Binding OpenContentFolderCommand}" />
              <MenuItem Header="Open Game Folder" Command="{Binding OpenGameFolderCommand}" />
              <MenuItem Header="Refresh Addon List" Command="{Binding RefreshAddonsCommand}" />
              <Separator />
              <MenuItem Header="Clear VRAD3 Cache" Command="{Binding ClearVrad3CacheCommand}" />
              <MenuItem Header="Restart CS2 Tools" Command="{Binding RestartCs2Command}" />
              <MenuItem Header="Kill CS2 Tools" Command="{Binding KillCs2Command}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Addon Selector ComboBox -->
        <ComboBox Grid.Column="7"
                  ItemsSource="{Binding Addons}"
                  SelectedItem="{Binding SelectedAddon}"
                  Width="210"
                  Margin="4,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Selected Addon workspace">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="addons:Addon">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Edit Map (CS2) Button (prominent green button with Hammer icon launching CS2 Workshop Tools) -->
        <Button Grid.Column="8"
                Classes="success"
                Command="{Binding LaunchCs2Command}"
                ToolTip.Tip="Launch Hammer / CS2 Workshop Tools for selected addon"
                Margin="4,0"
                FontWeight="Bold"
                Padding="14,4">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Image Source="avares://Hammer5Tools.App/Assets/Icons/hammer_icon.png" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="Edit map" VerticalAlignment="Center" FontWeight="Bold" />
          </StackPanel>
        </Button>

        <!-- MapBuilder Quick Launch Button -->
        <Button Grid.Column="9"
                Content="🗺️"
                Command="{Binding OpenMapBuilderCommand}"
                ToolTip.Tip="Open Map Builder dialog"
                Margin="2,0,0,0"
                Padding="8,4" />
      </Grid>
    </Border>
  </Grid>
</Window>
