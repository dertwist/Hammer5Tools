<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Hammer5Tools.App.Features.Shell"
        xmlns:vm="using:Hammer5Tools.App.ViewModels"
        xmlns:addons="using:Hammer5Tools.Core.Addons"
        x:Class="Hammer5Tools.App.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="Hammer 5 Tools 7.0"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Top Menu Bar -->
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_Save Current" Command="{Binding SaveDocumentCommand}" HotKey="Ctrl+S" InputGesture="Ctrl+S" />
        <Separator />
        <MenuItem Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Addon">
        <MenuItem Header="Refresh Addon List" Command="{Binding RefreshAddonsCommand}" />
        <MenuItem Header="Open Content Folder" Command="{Binding OpenContentFolderCommand}" />
        <MenuItem Header="Open Game Folder" Command="{Binding OpenGameFolderCommand}" />
      </MenuItem>
      <MenuItem Header="_CS2">
        <MenuItem Header="Launch Workshop Tools" Command="{Binding LaunchCs2Command}" />
        <MenuItem Header="Restart Workshop Tools" Command="{Binding RestartCs2Command}" />
        <MenuItem Header="Kill Workshop Tools" Command="{Binding KillCs2Command}" />
        <Separator />
        <MenuItem Header="Clear VRAD3 Cache" Command="{Binding ClearVrad3CacheCommand}" />
      </MenuItem>
      <MenuItem Header="_Editors">
        <MenuItem Header="Loading Screen Editor" Command="{Binding OpenLoadingEditorCommand}" />
        <MenuItem Header="SoundEvent Editor" Command="{Binding OpenSoundEventEditorCommand}" />
        <MenuItem Header="Hotkey Editor" Command="{Binding OpenHotkeyEditorCommand}" />
        <MenuItem Header="DetailProp Editor" Command="{Binding OpenDetailPropEditorCommand}" />
      </MenuItem>
      <MenuItem Header="_Utilities">
        <MenuItem Header="Map Builder" Command="{Binding OpenMapBuilderCommand}" />
        <MenuItem Header="Workshop Manager" Command="{Binding OpenWorkshopManagerCommand}" />
        <MenuItem Header="Asset Tools (Rename / Relink)" Command="{Binding OpenAssetToolsCommand}" />
        <MenuItem Header="NavMesh Radar" Command="{Binding OpenNavMeshRadarCommand}" />
        <Separator />
        <MenuItem Header="Git Sync (Prototype)" Command="{Binding OpenGitSyncCommand}" />
        <MenuItem Header="Console Log" Command="{Binding OpenConsoleCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Documentation" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/dertwist/Hammer5Tools" />
        <MenuItem Header="Discord Community" Command="{Binding OpenUrlCommand}" CommandParameter="https://discord.gg/hammer5tools" />
        <MenuItem Header="GitHub Repository" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/dertwist/Hammer5Tools" />
        <Separator />
        <MenuItem Header="_About Hammer 5 Tools" />
      </MenuItem>
    </Menu>

    <!-- Center Document Tabs for Main Editors (Loading, SoundEvent, Hotkey, DetailProp) -->
    <TabControl Grid.Row="1"
                ItemsSource="{Binding Documents}"
                SelectedItem="{Binding ActiveDocument}"
                Background="#272727">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DocumentViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Content="✕"
                    Classes="subtle"
                    Command="{Binding CloseCommand}"
                    FontSize="10"
                    VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>

    <!-- Bottom Button Line with Console Line, Git Sync, Utilities, Actions, Addon Selector, Edit Map (Classic Hammer5Tools Layout) -->
    <Border Grid.Row="2" Background="#272727" BorderBrush="#464649" BorderThickness="0,1" Padding="8,5">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
        <!-- Left buttons: Git Sync, Console, About -->
        <Button Grid.Column="0" Content="Git Sync" Command="{Binding OpenGitSyncCommand}" ToolTip.Tip="Open Git synchronization dialog" Margin="0,0,4,0" />
        <Button Grid.Column="1" Content="Console" Command="{Binding OpenConsoleCommand}" ToolTip.Tip="Open Console and activity log dialog" Margin="0,0,4,0" />
        <Button Grid.Column="2" Content="About" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/dertwist/Hammer5Tools" ToolTip.Tip="About Hammer 5 Tools" Margin="0,0,6,0" />

        <!-- Center: Console Line showing status/logs and clickable to open console dialog -->
        <Border Grid.Column="3" Background="#202020" BorderBrush="#3f3f42" BorderThickness="1" CornerRadius="3" Margin="4,0" Padding="8,2" ToolTip.Tip="Console activity — click to open full console window">
          <Button Command="{Binding OpenConsoleCommand}" Classes="subtle" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" Padding="0">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="▶ " Foreground="#4a83c9" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
              <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" Foreground="#a5a5a5" VerticalAlignment="Center" FontSize="12" />
            </Grid>
          </Button>
        </Border>

        <!-- Utilities Menu Button (Map Builder, Workshop Manager, Asset Tools, NavMesh Radar dialogs) -->
        <Button Grid.Column="4" Content="Utilities ▾" Margin="4,0" ToolTip.Tip="Open standalone utility tools">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="Map Builder" Command="{Binding OpenMapBuilderCommand}" />
              <MenuItem Header="Workshop Manager" Command="{Binding OpenWorkshopManagerCommand}" />
              <MenuItem Header="Asset Tools (Rename / Relink)" Command="{Binding OpenAssetToolsCommand}" />
              <MenuItem Header="NavMesh Radar" Command="{Binding OpenNavMeshRadarCommand}" />
              <Separator />
              <MenuItem Header="Git Sync (Prototype)" Command="{Binding OpenGitSyncCommand}" />
              <MenuItem Header="Console Log" Command="{Binding OpenConsoleCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Actions Menu Button (Folder navigation, refresh, cache, CS2 controls) -->
        <Button Grid.Column="5" Content="Actions ▾" Margin="4,0" ToolTip.Tip="Addon actions and tool settings">
          <Button.Flyout>
            <MenuFlyout Placement="Top">
              <MenuItem Header="Open Content Folder" Command="{Binding OpenContentFolderCommand}" />
              <MenuItem Header="Open Game Folder" Command="{Binding OpenGameFolderCommand}" />
              <MenuItem Header="Refresh Addon List" Command="{Binding RefreshAddonsCommand}" />
              <Separator />
              <MenuItem Header="Clear VRAD3 Cache" Command="{Binding ClearVrad3CacheCommand}" />
              <MenuItem Header="Restart CS2 Tools" Command="{Binding RestartCs2Command}" />
              <MenuItem Header="Kill CS2 Tools" Command="{Binding KillCs2Command}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- Addon Selector ComboBox -->
        <ComboBox Grid.Column="6"
                  ItemsSource="{Binding Addons}"
                  SelectedItem="{Binding SelectedAddon}"
                  Width="210"
                  Margin="4,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Selected Addon workspace">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="addons:Addon">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Edit Map (CS2) Button (prominent green button launching CS2 Workshop Tools) -->
        <Button Grid.Column="7"
                Content="Edit map"
                Classes="success"
                Command="{Binding LaunchCs2Command}"
                ToolTip.Tip="Launch Hammer / CS2 Workshop Tools for selected addon"
                Margin="4,0"
                FontWeight="Bold"
                Padding="16,5" />

        <!-- MapBuilder Quick Launch Button -->
        <Button Grid.Column="8"
                Content="🗺️"
                Command="{Binding OpenMapBuilderCommand}"
                ToolTip.Tip="Open Map Builder dialog"
                Margin="2,0,0,0"
                Padding="8,5" />
      </Grid>
    </Border>
  </Grid>
</Window>
