# .NET (net_core) — built by CI and makefile.py, never committed.

# Negate the global *.core (line ~5) and *.sln (line ~50) rules so they don't
# swallow the .NET library sources and solution file. With
# core.ignorecase=true the directory name matched the *.core glob, which had
# silently kept the entire SourcePorter.Core tree out of git. Last-match-wins,
# so these re-inclusions override the broader patterns above.
!Hammer5ToolsCore/SourcePorter.Core/
!Hammer5ToolsCore/SourcePorter.Core/**
!Hammer5ToolsCore/Hammer5Tools.Core/
!Hammer5ToolsCore/Hammer5Tools.Core/**
!Hammer5ToolsCore/Hammer5Tools.slnx

# Build artifacts (mirrors the local src/net_core/UnrealBridge/.gitignore).
# Placed AFTER the negation above so last-match-wins keeps them ignored even
# inside SourcePorter.Core/.
Hammer5ToolsCore/**/bin/
Hammer5ToolsCore/**/obj/
Hammer5ToolsCore/**/publish/
src/net_core/**/publish/
src/net_core/**/TestResults/
TestResults/
/SoundEventEditor/*
Hammer5Tools/userdata
