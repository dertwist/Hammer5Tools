{
    "version": "2.0.0",
    "tasks": [
        {
            // Builds every .NET project at once — net_core.sln holds all three
            // (SourcePorter.Core, its tests, and UnrealBridge). Release because
            // that is the path bridge_client.py loads the bridge dll from.
            // CUE4ParsePath points at a sibling clone of
            // https://github.com/FabianFG/CUE4Parse (see UnrealBridge/README.md);
            // change it here if yours lives elsewhere.
            "label": "build-all",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/net_core/net_core.sln",
                "-c",
                "Release",
                "-p:CUE4ParsePath=${workspaceFolder}/../CUE4Parse",
                "-p:CUE4PARSE_SKIP_NATIVE=true"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build-sourceporter",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/src/net_core/SourcePorter.Core/SourcePorter.Core.csproj",
                "-c",
                "Debug"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}
