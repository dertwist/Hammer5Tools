{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/Hammer5ToolsGUI/gui/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/Hammer5ToolsGUI",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "makefile",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/makefile.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/Hammer5ToolsGUI",
                "PYTHONUNBUFFERED": "1"
            },
            "args": [
                "--build-all",
                "--dev",
                "--package"
            ]
        },
        {
            "name": "compile_ui",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/compile_ui.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}
