IDI_ICON1 ICON "../Hammer5ToolsGUI/gui/appicon.ico"
IDI_ICON2 ICON "../Hammer5ToolsGUI/gui/icons/smartprop.ico"
IDI_ICON3 ICON "../Hammer5ToolsGUI/gui/icons/tools/vconsole/appicon.ico"
IDI_ICON4 ICON "../Hammer5ToolsGUI/gui/icons/tools/appicon_tools.ico"

1 VERSIONINFO
FILEVERSION @H5T_VERSION_COMMAS@,0
PRODUCTVERSION @H5T_VERSION_COMMAS@,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Hammer 5 Tools Launcher\0"
            VALUE "FileVersion", "@H5T_VERSION@\0"
            VALUE "ProductName", "Hammer 5 Tools\0"
            VALUE "ProductVersion", "@H5T_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
