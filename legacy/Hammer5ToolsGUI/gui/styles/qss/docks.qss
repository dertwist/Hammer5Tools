/* QDockWidget. Split out of qt_global_stylesheet.py during the
   styling-refactor migration. Behavior preserved as-is. */

QDockWidget {
    font: 9pt "Segoe UI";
    color: @text;
    background-color: @hex_3d3d3d;
    border: 2px solid @background;
}

QDockWidget::title {
    background-color: @background;
    font: 9pt "Segoe UI";
    color: @text;
}

QDockWidget::slider {
    color: @background;
}
QDockWidget::close-button, QDockWidget::float-button {
    border: 1px solid @background;
    background: @background;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: @selection;
}

QDockWidget::close-button:pressed, QDockWidget::float-button:pressed {
    background: @background;
}

QDockWidget DockTitleWidget {
  border-top: 1px solid @hex_c0c0c0;
  border-bottom: 1px solid @hex_c0c0c0;
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
    stop: 0.0 @hex_d4d4d4, stop: 0.3 @hex_d0d0d0,
    stop: 0.7 @hex_cfcfcf, stop: 1.0 @hex_c8c8c8);
}
QDockWidget DockTitleWidget QPushButton,
QDockWidget DockTitleWidget QToolButton {
  background: transparent;
  border: 1px solid transparent;
  right: 6px;
  top: 3px;
}
QDockWidget DockTitleWidget QPushButton:hover,
QDockWidget DockTitleWidget QToolButton:hover {
  border-color: @hex_939393;
  border-radius: 2px;
  background: qlineargradient(x1:0, y1 : 0, x2 : 0, y2 : 1,
    stop : 0.0 @hex_a8a8a8, stop : 0.3 @hex_b3b3b3,
    stop : 0.7 @hex_b2b2b2, stop : 1.0 @hex_aaaaaa);
}
QDockWidget DockTitleWidget QPushButton::menu-indicator,
QDockWidget DockTitleWidget QToolButton::menu-indicator {
  image: none;
}
