/* "No document/asset open yet" placeholder view shared by AssetGroupMaker,
   SmartProp Editor, SoundEvent Editor, and Loading Editor main windows. */
QLabel[h5Component="emptyStateTitle"] {
    font: 700 13pt "Segoe UI";
    color: @text;
}
QLabel[h5Component="emptyStateDescription"] {
    font: 500 9.5pt "Segoe UI";
    color: @hex_9d9d9d;
}
