<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.3" />

    <!-- Dock -->
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.6" />

    <!-- MVVM & DI -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />

    <PackageVersion Include="CS2WorkshopManager" Version="1.4.0" />
    <PackageVersion Include="Dock.Serializer.SystemTextJson" Version="12.1.0.6" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />

    <!-- Source 2 & Valve formats -->
    <PackageVersion Include="ValveResourceFormat" Version="20.0.6980" />
    <PackageVersion Include="ValvePak" Version="6.0.0.182" />
    <PackageVersion Include="ValveKeyValue" Version="0.71.0.528" />
    <PackageVersion Include="KeyValues2" Version="1.0.0" />
    <PackageVersion Include="Sledge.Formats.Map" Version="1.2.9" />
    <PackageVersion Include="Sledge.Formats.Texture" Version="1.1.0" />
    <PackageVersion Include="Sledge.Formats.GameData" Version="1.1.8" />

    <!-- CLI -->
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.57.2" />

    <!-- Testing -->
    <PackageVersion Include="TUnit" Version="1.72.16" />
  </ItemGroup>
</Project>
