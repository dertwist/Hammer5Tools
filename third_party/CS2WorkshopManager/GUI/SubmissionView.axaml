<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:GUI"
             mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="900"
             x:Class="GUI.SubmissionView">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource ContrastBrush}" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- labels of tall boxes sit at their top like the workshop manager's -->
        <Style Selector="TextBlock.label.top">
            <Setter Property="Margin" Value="0,6,12,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <!-- video tiles stay where they are, so they do not invite a drag -->
        <Style Selector="Border.video">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <!-- the description's formatting buttons, small and in a row, that leave the focus and the selection in the text box -->
        <Style Selector=":is(Button).format">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="8,6">
        <!-- what is being published, with the way back to the list where the toolbar was -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Name="BackButton" Classes="tool" Click="OnCancel">
                <StackPanel>
                    <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/back.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Text="Back" />
                </StackPanel>
            </Button>
            <SelectableTextBlock Name="Heading" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource ContrastBrush}" />
        </DockPanel>

        <!-- progress and the outcome, with the workshop manager's buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Name="CancelButton" Content="Cancel" MinWidth="80" Click="OnCancel" />
                <Button Name="SubmitButton" Content="Submit" Classes="accent" MinWidth="80" Click="OnSubmit" />
            </StackPanel>
            <TextBlock Name="Status" DockPanel.Dock="Left" Width="320" Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource ContrastBrush}" TextTrimming="CharacterEllipsis" />
            <!-- the status keeps a fixed width so the bar does not change size as the text does -->
            <ProgressBar Name="UploadProgress" Margin="16,0" Minimum="0" Maximum="1" IsVisible="False" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Name="Form" ColumnDefinitions="*,16,*">
            <!-- the preview image, as big as the window allows, picked by dropping or browsing, with the gallery that goes under it on the workshop page -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Add Screenshots" Click="OnAddScreenshots" />
                    <Button Content="Add Video" Click="OnAddVideo" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Background="{DynamicResource ShadeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                    <Panel MinHeight="132">
                        <TextBlock Name="GalleryHint" Text="Add screenshots or a video to show under the thumbnail" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ContrastSoftBrush}" />
                        <ScrollViewer MaxHeight="272">
                            <ItemsControl Name="Gallery" PointerMoved="OnGalleryPointerMoved" PointerReleased="OnGalleryPointerReleased" PointerCaptureLost="OnGalleryCaptureLost">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:GalleryEntry">
                                        <!-- a picture tile is held and dragged over another to take its place, videos come first and stay there -->
                                        <Border Width="168" Margin="0,0,8,8" Padding="4" CornerRadius="5" Background="{DynamicResource FieldBrush}" Cursor="Hand" Classes.video="{Binding IsVideo}" PointerPressed="OnTilePressed">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                                    <Button DockPanel.Dock="Right" Padding="5" ToolTip.Tip="Remove" Click="OnRemovePreview">
                                                        <Image Source="avares://CS2WorkshopManager-GUI/assets/buttons/delete.png" Width="14" Height="14" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                                    </Button>
                                                    <TextBlock Text="{Binding Caption}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ContrastSoftBrush}" ToolTip.Tip="{Binding Caption}" />
                                                </DockPanel>
                                                <Panel Height="90">
                                                    <TextBlock Text="{Binding Kind}" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ContrastSoftBrush}" />
                                                    <local:PreviewImage Source="{Binding Thumbnail}" />
                                                    <!-- the play badge of a video, in YouTube's red -->
                                                    <Border IsVisible="{Binding IsVideo}" Width="44" Height="30" CornerRadius="7" Background="#D9FF0000" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Path Data="M0,0 L12,7 L0,14 Z" Fill="White" Width="12" Height="14" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </Panel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Browse" MinWidth="80" Click="OnBrowse" />
                    <Button Content="Clear" MinWidth="80" Click="OnClearPreview" />
                </StackPanel>
                <TextBlock Name="PreviewPath" DockPanel.Dock="Bottom" Margin="0,8,0,0" IsVisible="False" Foreground="{DynamicResource ContrastSoftBrush}" TextTrimming="CharacterEllipsis" />
                <Border Name="PreviewDrop" Background="{DynamicResource ShadeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" DragDrop.AllowDrop="True">
                    <Panel Margin="12">
                        <TextBlock Name="PreviewHint" Text="Drag an image here or click Browse" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ContrastSoftBrush}" />
                        <local:PreviewImage Name="Preview" />
                    </Panel>
                </Border>
            </DockPanel>

            <!-- the submission's info, the description takes whatever height is left -->
            <Border Grid.Column="2" Background="{DynamicResource ShadeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                    <TextBlock Name="ChangeNoteLabel" Classes="label top" Text="Change Log:" />
                    <TextBox Name="ChangeNoteBox" Grid.Column="1" Margin="0,0,0,12" Height="90" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Type your update notes for this change here" />

                    <TextBlock Grid.Row="1" Classes="label" Text="Title:" />
                    <TextBox Name="TitleBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="2" Classes="label top" Text="Description:" />
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                        <!-- Steam's text formatting: buttons wrap the selection in its tags, and the preview shows the result the way the workshop page would -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                <ToggleButton Name="EditToggle" Classes="format" Content="Edit" IsChecked="True" Click="OnDescriptionViewToggle" />
                                <ToggleButton Name="PreviewToggle" Classes="format" Content="Preview" Click="OnDescriptionViewToggle" />
                            </StackPanel>
                            <!-- the buttons scroll sideways when the window is too narrow for them all, rather than wrapping, on a bar below them rather than one that pops over them -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False" Margin="0,0,8,0">
                            <StackPanel Name="FormatButtons" Orientation="Horizontal" Spacing="4">
                                <Button Classes="format" Content="B" FontWeight="Bold" Tag="b" Click="OnFormat" />
                                <Button Classes="format" Content="I" FontStyle="Italic" Tag="i" Click="OnFormat" />
                                <Button Classes="format" Tag="u" Click="OnFormat"><TextBlock Text="U" TextDecorations="Underline" /></Button>
                                <Button Classes="format" Tag="strike" Click="OnFormat"><TextBlock Text="S" TextDecorations="Strikethrough" /></Button>
                                <Button Classes="format" Content="H1" Tag="h1" Click="OnFormat" />
                                <Button Classes="format" Content="H2" Tag="h2" Click="OnFormat" />
                                <Button Classes="format" Content="Link" Tag="url" Click="OnFormat" />
                                <Button Classes="format" Content="List" Tag="list" Click="OnFormat" />
                                <Button Classes="format" Content="Image" Tag="img" Click="OnFormat" />
                                <Button Classes="format" Content="Code" Tag="code" Click="OnFormat" />
                                <Button Classes="format" Content="Spoiler" Tag="spoiler" Click="OnFormat" />
                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                        <Panel>
                            <TextBox Name="DescriptionBox" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                            <ScrollViewer Name="DescriptionPreview" IsVisible="False" Background="{DynamicResource FieldBrush}" Padding="12,10" TextElement.Foreground="{DynamicResource ContrastSoftBrush}">
                                <local:BbCodeView Name="DescriptionRendered" />
                            </ScrollViewer>
                        </Panel>
                    </DockPanel>

                    <TextBlock Name="AddonLabel" Grid.Row="3" Classes="label top" Text="Addon Folder:" />
                    <StackPanel Name="AddonPanel" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Spacing="8">
                        <ComboBox Name="AddonBox" HorizontalAlignment="Stretch" SelectionChanged="OnAddonChanged" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Files" VerticalAlignment="Top" Margin="8,0,0,0" Click="OnFiles" />
                            <local:ContentsBar Name="Contents" Height="44" Foreground="{DynamicResource ContrastBrush}" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Classes="label" Text="Game Modes:" />
                    <DropDownButton Name="GameModesButton" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="None">
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Name="GameModesList" Spacing="4" />
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <TextBlock Grid.Row="5" Classes="label" Text="Visibility:" Margin="0,0,12,0" />
                    <ComboBox Name="VisibilityBox" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
