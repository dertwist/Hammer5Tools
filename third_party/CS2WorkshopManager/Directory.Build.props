<Project>
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>embedded</DebugType>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AnalysisMode Condition="'$(Configuration)' == 'Release'">All</AnalysisMode>
    <AnalysisMode Condition="'$(Configuration)' != 'Release'">Recommended</AnalysisMode>
    <Nullable>enable</Nullable>

    <!-- the one place the version lives, the release workflow tags and publishes whatever stands here -->
    <Version>1.4.0</Version>

    <Authors>Angel</Authors>
    <Copyright>Copyright © Angel</Copyright>
    <RepositoryUrl>https://github.com/Angel-foxxo/CS2-Workshop-Manager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Angel-foxxo/CS2-Workshop-Manager</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <!-- CA2000 is very slow: https://github.com/dotnet/roslyn-analyzers/issues/4915 -->
    <NoWarn>$(NoWarn);CA2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Numerics" />
    <Using Include="System.Collections.Generic" />
  </ItemGroup>
</Project>
