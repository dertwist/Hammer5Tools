<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);CS2WorkshopManager/**;Steamworks/**;NativeAot/**</DefaultItemExcludes>
    <Description>Hammer5Tools domain logic, file formats, filesystem and process services</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="CS2WorkshopManager/CS2WorkshopManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ValveResourceFormat" />
    <PackageReference Include="ValvePak" />
    <PackageReference Include="ValveKeyValue" />
    <PackageReference Include="KeyValues2" />
    <PackageReference Include="Sledge.Formats.Map" />
    <PackageReference Include="Sledge.Formats.Texture" />
    <PackageReference Include="Sledge.Formats.GameData" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Format/SmartProps/SmartPropEditorTemplates.json" LogicalName="SmartPropEditorTemplates" />
    <EmbeddedResource Include="Hotkeys/HotkeyDefinitions.json" LogicalName="HotkeyDefinitions" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="FFMediaToolkit" />
    <PackageReference Include="FFmpeg.LGPL" GeneratePathProperty="true" ExcludeAssets="build;buildTransitive;runtime" />
    <Content Include="$(PkgFFmpeg_LGPL)/build/native/bin/*.dll" Link="ffmpeg/win-x64/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgFFmpeg_LGPL)/build/native/LICENSE.txt" Link="licenses/FFmpeg-LGPL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Misc/FFMediaToolkit/*" Link="licenses/FFMediaToolkit/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="Hammer5Tools.Core.Tests" />
    <Content Include="../Misc/Source2Viewer/LICENSE" Link="licenses/ValveResourceFormat-SmartProps.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
