<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);CS2WorkshopManager/**;Steamworks/**;NativeAot/**;external/**</DefaultItemExcludes>
    <Description>Hammer5Tools domain logic, file formats, filesystem and process services</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="CS2WorkshopManager/CS2WorkshopManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ValveResourceFormat">
      <HintPath>external/ValveResourceFormat.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="external/ValveResourceFormat.dll" Link="ValveResourceFormat.dll" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <PackageReference Include="ValveResourceFormat" ExcludeAssets="compile;runtime" />
    <PackageReference Include="ValvePak" />
    <PackageReference Include="ValveKeyValue" />
    <PackageReference Include="KeyValues2" />
    <PackageReference Include="Sledge.Formats.Map" />
    <PackageReference Include="Sledge.Formats.Texture" />
    <PackageReference Include="Sledge.Formats.GameData" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Format/SmartProps/SmartPropEditorTemplates.json" LogicalName="SmartPropEditorTemplates" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
</Project>
