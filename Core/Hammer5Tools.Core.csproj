    <PackageReference Include="Sledge.Formats.Map" />
    <PackageReference Include="Sledge.Formats.Texture" />
    <PackageReference Include="Sledge.Formats.GameData" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Format/SmartProps/SmartPropEditorTemplates.json" LogicalName="SmartPropEditorTemplates" />
